
@model AJACAS.Models.WorkExperience

@{
    ViewData["Title"] = "Edit Work Experience";
}

@await Html.PartialAsync("BackButton")

<div class="experience-form-page">

    <div class="experience-form-wrapper">

        <!-- HEADER -->
        <div class="experience-form-header">

            <div class="experience-form-eyebrow">
                <span class="eyebrow-dot"></span>
                PROFESSIONAL EXPERIENCE
            </div>

            <h1>Edit Work Experience</h1>

            <p>
                Update your professional experience and keep
                your career profile accurate.
            </p>

        </div>


        <!-- FORM CARD -->
        <div class="experience-form-card">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="WorkExperienceId" />


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- ROLE INFORMATION -->
                <div class="form-section">

                    <div class="form-section-heading">

                        <div class="section-icon">
                            <i class="bi bi-briefcase"></i>
                        </div>

                        <div>

                            <h3>Role Information</h3>

                            <p>
                                Update your company and position details.
                            </p>

                        </div>

                    </div>


                    <!-- COMPANY -->
                    <div class="field-group">

                        <label asp-for="CompanyName"
                               class="ajacas-label">
                            Company Name
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-building"></i>

                            <input asp-for="CompanyName"
                                   class="ajacas-input" />

                        </div>

                        <span asp-validation-for="CompanyName"
                              class="field-error">
                        </span>

                    </div>


                    <!-- JOB TITLE -->
                    <div class="field-group">

                        <label asp-for="JobTitle"
                               class="ajacas-label">
                            Job Title
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-person-badge"></i>

                            <input asp-for="JobTitle"
                                   class="ajacas-input" />

                        </div>

                        <span asp-validation-for="JobTitle"
                              class="field-error">
                        </span>

                    </div>


                    <!-- LOCATION -->
                    <div class="field-group">

                        <label asp-for="Location"
                               class="ajacas-label">
                            Location
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-geo-alt"></i>

                            <input asp-for="Location"
                                   class="ajacas-input" />

                        </div>

                        <span asp-validation-for="Location"
                              class="field-error">
                        </span>

                    </div>

                </div>


                <!-- EMPLOYMENT PERIOD -->
                <div class="form-section">

                    <div class="form-section-heading">

                        <div class="section-icon">
                            <i class="bi bi-calendar3"></i>
                        </div>

                        <div>

                            <h3>Employment Period</h3>

                            <p>
                                Update the duration of this position.
                            </p>

                        </div>

                    </div>


                    <div class="form-row">

                        <!-- START DATE -->
                        <div class="field-group">

                            <label asp-for="StartDate"
                                   class="ajacas-label">
                                Start Date
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-calendar-plus"></i>

                                <input asp-for="StartDate"
                                       type="date"
                                       class="ajacas-input" />

                            </div>

                            <span asp-validation-for="StartDate"
                                  class="field-error">
                            </span>

                        </div>


                        <!-- END DATE -->
                        <div class="field-group">

                            <label asp-for="EndDate"
                                   class="ajacas-label">
                                End Date
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-calendar-check"></i>

                                <input asp-for="EndDate"
                                       type="date"
                                       class="ajacas-input" />

                            </div>

                            <span asp-validation-for="EndDate"
                                  class="field-error">
                            </span>

                        </div>

                    </div>


                    <!-- CURRENT JOB -->
                    <div class="current-job">

                        <input asp-for="IsCurrent"
                               class="current-checkbox"
                               id="isCurrent" />

                        <label asp-for="IsCurrent"
                               class="current-label">

                            <span class="custom-check">
                                <i class="bi bi-check"></i>
                            </span>

                            <span>

                                <strong>
                                    I currently work here
                                </strong>

                                <small>
                                    Mark this if this is your current job.
                                </small>

                            </span>

                        </label>

                    </div>

                </div>


                <!-- DESCRIPTION -->
                <div class="form-section">

                    <div class="form-section-heading">

                        <div class="section-icon">
                            <i class="bi bi-file-text"></i>
                        </div>

                        <div>

                            <h3>Role Description</h3>

                            <p>
                                Update your responsibilities and achievements.
                            </p>

                        </div>

                    </div>


                    <div class="field-group">

                        <label asp-for="Description"
                               class="ajacas-label">
                            Description
                        </label>

                        <div class="textarea-wrapper">

                            <i class="bi bi-pencil-square"></i>

                            <textarea asp-for="Description"
                                      class="ajacas-textarea"
                                      rows="5"></textarea>

                        </div>

                        <span asp-validation-for="Description"
                              class="field-error">
                        </span>

                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <button type="submit"
                            class="save-btn">

                        <i class="bi bi-check2-circle"></i>

                        Save Changes

                    </button>


                    <a asp-action="Index"
                       class="cancel-btn">

                        <i class="bi bi-x-lg"></i>

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


<style>

    /* =========================================
           EXPERIENCE EDIT PAGE
           ========================================= */

    .experience-form-page {
        min-height: 100vh;
        padding: 55px 20px 80px;
        color: #eef3ef;
        animation: formPageIn .7s ease both;
    }


    .experience-form-wrapper {
        max-width: 850px;
        margin: 0 auto;
    }


    .experience-form-header {
        margin-bottom: 35px;
    }


    .experience-form-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
        color: #39ff88;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }


    .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #39ff88;
        box-shadow: 0 0 12px rgba(57,255,136,.8);
    }


    .experience-form-header h1 {
        margin: 0;
        color: #f4f8f5;
        font-size: clamp(34px, 5vw, 48px);
        font-weight: 700;
        letter-spacing: -1.5px;
    }


    .experience-form-header p {
        max-width: 650px;
        margin: 12px 0 0;
        color: #7c8792;
        font-size: 15px;
        line-height: 1.7;
    }


    .experience-form-card {
        position: relative;
        padding: 32px;
        border-radius: 23px;
        border: 1px solid rgba(255,255,255,.07);
        background: linear-gradient( 145deg, rgba(255,255,255,.045), rgba(255,255,255,.018) );
        box-shadow: 0 20px 60px rgba(0,0,0,.16);
        overflow: hidden;
    }


        .experience-form-card::before {
            content: "";
            position: absolute;
            top: -130px;
            right: -100px;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(57,255,136,.035);
            filter: blur(45px);
            pointer-events: none;
        }


    .form-section {
        position: relative;
        padding-bottom: 30px;
        margin-bottom: 30px;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }


    .form-section-heading {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 26px;
    }


    .section-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 13px;
        background: rgba(57,255,136,.08);
        border: 1px solid rgba(57,255,136,.14);
        color: #39ff88;
        font-size: 18px;
    }


    .form-section-heading h3 {
        margin: 0 0 4px;
        color: #edf3ef;
        font-size: 16px;
        font-weight: 650;
    }


    .form-section-heading p {
        margin: 0;
        color: #68737d;
        font-size: 12px;
    }


    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }


    .field-group {
        margin-bottom: 21px;
    }


    .ajacas-label {
        display: block;
        margin-bottom: 9px;
        color: #cdd5cf;
        font-size: 12px;
        font-weight: 600;
    }


    .input-wrapper,
    .textarea-wrapper {
        position: relative;
    }


        .input-wrapper > i,
        .textarea-wrapper > i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #5f6c65;
            font-size: 15px;
            pointer-events: none;
            transition: color .2s ease;
        }


        .textarea-wrapper > i {
            top: 20px;
            transform: none;
        }


    .ajacas-input,
    .ajacas-textarea {
        width: 100%;
        border-radius: 11px;
        border: 1px solid rgba(255,255,255,.08);
        outline: none;
        background: rgba(0,0,0,.18);
        color: #edf4ee;
        font-size: 13px;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }


    .ajacas-input {
        min-height: 48px;
        padding: 12px 15px 12px 43px;
    }


    .ajacas-textarea {
        min-height: 125px;
        padding: 14px 15px 14px 43px;
        resize: vertical;
    }


        .ajacas-input::placeholder,
        .ajacas-textarea::placeholder {
            color: #56615b;
        }


        .ajacas-input:focus,
        .ajacas-textarea:focus {
            border-color: rgba(57,255,136,.4);
            background: rgba(57,255,136,.025);
            box-shadow: 0 0 0 3px rgba(57,255,136,.06);
        }


    .input-wrapper:focus-within > i,
    .textarea-wrapper:focus-within > i {
        color: #39ff88;
    }


    /* CURRENT JOB */

    .current-job {
        margin-top: 5px;
    }


    .current-checkbox {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }


    .current-label {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,.07);
        background: rgba(255,255,255,.02);
        cursor: pointer;
        transition: border-color .2s ease, background .2s ease;
    }


        .current-label:hover {
            border-color: rgba(57,255,136,.2);
            background: rgba(57,255,136,.035);
        }


    .custom-check {
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,.16);
        color: transparent;
        transition: all .2s ease;
    }


        .custom-check i {
            font-size: 13px;
        }


    .current-checkbox:checked + .current-label
    .custom-check {
        border-color: #39ff88;
        background: #39ff88;
        color: #07100b;
        box-shadow: 0 0 15px rgba(57,255,136,.2);
    }


    .current-label strong {
        display: block;
        margin-bottom: 3px;
        color: #dce5df;
        font-size: 12px;
    }


    .current-label small {
        display: block;
        color: #68737d;
        font-size: 10px;
    }


    /* VALIDATION */

    .field-error {
        display: block;
        margin-top: 6px;
        color: #ff7885;
        font-size: 11px;
    }


    .validation-summary {
        position: relative;
        margin-bottom: 20px;
        color: #ff7885;
        font-size: 12px;
    }


    /* ACTIONS */

    .form-actions {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .save-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 21px;
        border: none;
        border-radius: 11px;
        background: #39ff88;
        color: #07100b;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 0 22px rgba(57,255,136,.12);
        transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
    }


        .save-btn:hover {
            color: #07100b;
            background: #57ff9b;
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(57,255,136,.22);
        }


    .cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 19px;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 11px;
        background: rgba(255,255,255,.025);
        color: #87918b;
        text-decoration: none;
        font-size: 13px;
        transition: all .2s ease;
    }


        .cancel-btn:hover {
            color: #dce5df;
            border-color: rgba(255,255,255,.15);
            background: rgba(255,255,255,.05);
            transform: translateY(-2px);
        }


    /* ANIMATION */

    @@keyframes formPageIn {

        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* RESPONSIVE */

    @@media (max-width: 700px) {

        .experience-form-page {
            padding: 40px 20px 60px;
        }

        .experience-form-card {
            padding: 23px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }


    @@media (max-width: 500px) {

        .experience-form-header h1 {
            font-size: 34px;
        }

        .experience-form-card {
            padding: 19px;
        }

        .form-section-heading {
            align-items: flex-start;
        }

        .form-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .save-btn,
        .cancel-btn {
            width: 100%;
        }
    }

</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}