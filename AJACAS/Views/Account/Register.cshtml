@model AJACAS.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<style>
    .auth-page {
        min-height: 100vh;
        padding: 50px 20px 70px;
        color: #f2f5f3;
    }

    .auth-wrapper {
        max-width: 520px;
        margin: 0 auto;
    }

    .auth-header {
        margin-bottom: 30px;
        animation: fadeUp .6s ease both;
    }

    .auth-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #39ff88;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 11px;
    }

        .auth-eyebrow span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #39ff88;
            box-shadow: 0 0 12px rgba(57,255,136,.8);
        }

    .auth-header h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -1px;
        margin-bottom: 8px;
    }

    .auth-header p {
        color: #7c8792;
        font-size: .9rem;
        line-height: 1.7;
        margin: 0;
    }

    .auth-card {
        position: relative;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 23px;
        padding: 30px;
        backdrop-filter: blur(16px);
        box-shadow: 0 20px 65px rgba(0,0,0,.18);
        animation: fadeUp .75s ease both;
        overflow: hidden;
    }

        .auth-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(57,255,136,.035);
            filter: blur(50px);
            top: -100px;
            right: -80px;
            pointer-events: none;
        }

    .form-section {
        margin-bottom: 21px;
        position: relative;
        z-index: 1;
    }

    .form-label {
        color: #aeb8b1;
        font-size: .76rem;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .form-control {
        min-height: 48px;
        padding: 11px 14px;
        color: #f2f5f3 !important;
        background: rgba(255,255,255,.025) !important;
        border: 1px solid rgba(255,255,255,.09) !important;
        border-radius: 11px !important;
        box-shadow: none !important;
        transition: .25s ease;
    }

        .form-control::placeholder {
            color: #59645d;
        }

        .form-control:focus {
            background: rgba(57,255,136,.025) !important;
            border-color: rgba(57,255,136,.4) !important;
            box-shadow: 0 0 0 3px rgba(57,255,136,.055) !important;
        }

    .validation-summary {
        background: rgba(255,70,70,.045);
        border: 1px solid rgba(255,70,70,.15);
        border-radius: 11px;
        padding: 12px 14px;
        font-size: .75rem;
        margin-bottom: 20px;
    }

    .validation-message {
        display: block;
        color: #ff7777;
        font-size: .7rem;
        margin-top: 6px;
    }

    /* Password requirements panel */
    .password-requirements {
        margin-top: 12px;
        padding: 14px 15px;
        background: rgba(57,255,136,.045);
        border: 1px solid rgba(57,255,136,.13);
        border-radius: 12px;
        color: #aeb8b1;
        font-size: .73rem;
        line-height: 1.6;
    }

    .password-requirements-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
        color: #39ff88;
        font-size: .76rem;
        font-weight: 700;
    }

        .password-requirements-title i {
            font-size: .9rem;
        }

    .password-requirements p {
        margin: 0 0 9px;
        color: #87938b;
    }

    .password-requirements ul {
        display: grid;
        gap: 6px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .password-requirements li {
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

        .password-requirements li i {
            color: #39ff88;
            font-size: .8rem;
            margin-top: 3px;
            flex-shrink: 0;
        }

    .auth-button {
        width: 100%;
        min-height: 48px;
        border: 1px solid rgba(57,255,136,.25);
        border-radius: 11px;
        background: #39ff88;
        color: #07100b;
        font-size: .8rem;
        font-weight: 750;
        transition: .25s ease;
        position: relative;
        z-index: 1;
    }

        .auth-button:hover {
            background: #4dff96;
            color: #07100b;
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(57,255,136,.13);
        }

        .auth-button i {
            margin-right: 7px;
        }

    .auth-footer {
        text-align: center;
        margin-top: 23px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.06);
        color: #69746d;
        font-size: .78rem;
        position: relative;
        z-index: 1;
    }

        .auth-footer a {
            color: #39ff88;
            text-decoration: none;
            font-weight: 650;
            margin-left: 4px;
            transition: .2s ease;
        }

            .auth-footer a:hover {
                color: #72ffa8;
            }

    .security-line {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: #505b54;
        font-size: .68rem;
        margin-top: 17px;
        position: relative;
        z-index: 1;
    }

        .security-line i {
            color: #39ff88;
        }

    /* Light mode */
    html[data-theme="light"] .auth-page {
        color: #17251f;
    }

    html[data-theme="light"] .auth-header p {
        color: #637168;
    }

    html[data-theme="light"] .auth-card {
        background: rgba(255,255,255,.88);
        border-color: #dce8df;
        box-shadow: 0 20px 65px rgba(28,58,39,.08);
    }

        html[data-theme="light"] .auth-card::before {
            background: rgba(57,190,105,.07);
        }

    html[data-theme="light"] .form-label {
        color: #34483b;
    }

    html[data-theme="light"] .form-control {
        color: #17251f !important;
        background: #ffffff !important;
        border-color: #d7e2da !important;
    }

        html[data-theme="light"] .form-control::placeholder {
            color: #89968d;
        }

        html[data-theme="light"] .form-control:focus {
            background: #fbfffc !important;
            border-color: #39b96b !important;
            box-shadow: 0 0 0 3px rgba(57,185,107,.12) !important;
        }

    html[data-theme="light"] .password-requirements {
        background: #f3faf5;
        border-color: #d8eadc;
        color: #34483b;
    }

    html[data-theme="light"] .password-requirements-title {
        color: #16803d;
    }

    html[data-theme="light"] .password-requirements p {
        color: #627267;
    }

    html[data-theme="light"] .password-requirements li i {
        color: #16803d;
    }

    html[data-theme="light"] .auth-footer {
        border-top-color: #e2eae4;
        color: #627267;
    }

        html[data-theme="light"] .auth-footer a {
            color: #16803d;
        }

    html[data-theme="light"] .security-line {
        color: #66766b;
    }

        html[data-theme="light"] .security-line i {
            color: #16803d;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 600px) {
        .auth-page {
            padding: 35px 15px 50px;
        }

        .auth-card {
            padding: 23px 20px;
            border-radius: 20px;
        }
    }
</style>

<div class="auth-page">
    <div class="auth-wrapper">

        <div class="auth-header">
            <div class="auth-eyebrow">
                <span></span>
                JOIN AJACAS
            </div>

            <h1>Create your account</h1>

            <p>
                Build your professional profile and unlock
                AI-powered tools designed to help you grow your career.
            </p>
        </div>

        <div class="auth-card">

            <form asp-action="Register" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary">
                </div>

                <div class="form-section">
                    <label asp-for="Email" class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-section">
                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Create a password"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="validation-message">
                    </span>

                    <div class="password-requirements">
                        <div class="password-requirements-title">
                            <i class="bi bi-shield-lock"></i>
                            Password requirements
                        </div>

                        <p>
                            Create a strong password that meets the following requirements:
                        </p>

                        <ul>
                            <li>
                                <i class="bi bi-check-circle"></i>
                                <span>At least 8 characters long</span>
                            </li>
                            <li>
                                <i class="bi bi-check-circle"></i>
                                <span>At least one uppercase letter (A–Z)</span>
                            </li>
                            <li>
                                <i class="bi bi-check-circle"></i>
                                <span>At least one lowercase letter (a–z)</span>
                            </li>
                            <li>
                                <i class="bi bi-check-circle"></i>
                                <span>At least one number (0–9)</span>
                            </li>
                            <li>
                                <i class="bi bi-check-circle"></i>
                                <span>At least one special character (e.g. @@, #, !)</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="form-section">
                    <label asp-for="ConfirmPassword" class="form-label">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Confirm your password"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="validation-message">
                    </span>
                </div>

                <button type="submit" class="auth-button">
                    <i class="bi bi-person-plus"></i>
                    Create Account
                </button>

            </form>

            <div class="auth-footer">
                Already have an account?
                <a asp-action="Login">Sign in</a>
            </div>

            <div class="security-line">
                <i class="bi bi-shield-check"></i>
                Secure AJACAS account creation
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
