@model AJACAS.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>

    .auth-page {
        min-height: 100vh;
        padding: 50px 20px 70px;
        color: #f2f5f3;
    }

    .auth-wrapper {
        max-width: 520px;
        margin: 0 auto;
    }

    .auth-header {
        margin-bottom: 30px;
        animation: fadeUp .6s ease both;
    }

    .auth-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #39ff88;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 11px;
    }

        .auth-eyebrow span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #39ff88;
            box-shadow: 0 0 12px rgba(57,255,136,.8);
        }

    .auth-header h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -1px;
        margin-bottom: 8px;
    }

    .auth-header p {
        color: #7c8792;
        font-size: .9rem;
        line-height: 1.7;
        margin: 0;
    }

    .auth-card {
        position: relative;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 23px;
        padding: 30px;
        backdrop-filter: blur(16px);
        box-shadow: 0 20px 65px rgba(0,0,0,.18);
        animation: fadeUp .75s ease both;
        overflow: hidden;
    }

        .auth-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(57,255,136,.035);
            filter: blur(50px);
            top: -100px;
            right: -80px;
            pointer-events: none;
        }

    .form-section {
        margin-bottom: 21px;
        position: relative;
        z-index: 1;
    }

    .form-label {
        color: #aeb8b1;
        font-size: .76rem;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .form-control {
        min-height: 48px;
        padding: 11px 14px;
        color: #f2f5f3 !important;
        background: rgba(255,255,255,.025) !important;
        border: 1px solid rgba(255,255,255,.09) !important;
        border-radius: 11px !important;
        box-shadow: none !important;
        transition: .25s ease;
    }

        .form-control::placeholder {
            color: #59645d;
        }

        .form-control:focus {
            background: rgba(57,255,136,.025) !important;
            border-color: rgba(57,255,136,.4) !important;
            box-shadow: 0 0 0 3px rgba(57,255,136,.055) !important;
        }

    .form-check {
        margin-bottom: 23px;
    }

    .form-check-input {
        background-color: rgba(255,255,255,.025);
        border-color: rgba(255,255,255,.15);
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #39ff88;
            border-color: #39ff88;
        }

    .form-check-label {
        color: #7c8792;
        font-size: .78rem;
        cursor: pointer;
    }

    .validation-summary {
        background: rgba(255,70,70,.045);
        border: 1px solid rgba(255,70,70,.15);
        border-radius: 11px;
        padding: 12px 14px;
        font-size: .75rem;
        margin-bottom: 20px;
    }

    .validation-message {
        display: block;
        color: #ff7777;
        font-size: .7rem;
        margin-top: 6px;
    }

    .auth-button {
        width: 100%;
        min-height: 48px;
        border: 1px solid rgba(57,255,136,.25);
        border-radius: 11px;
        background: #39ff88;
        color: #07100b;
        font-size: .8rem;
        font-weight: 750;
        transition: .25s ease;
    }

        .auth-button:hover {
            background: #4dff96;
            color: #07100b;
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(57,255,136,.13);
        }

        .auth-button i {
            margin-right: 7px;
        }

    .auth-footer {
        text-align: center;
        margin-top: 23px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.06);
        color: #69746d;
        font-size: .78rem;
    }

        .auth-footer a {
            color: #39ff88;
            text-decoration: none;
            font-weight: 650;
            margin-left: 4px;
            transition: .2s ease;
        }

            .auth-footer a:hover {
                color: #72ffa8;
            }

    .security-line {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: #505b54;
        font-size: .68rem;
        margin-top: 17px;
    }

        .security-line i {
            color: #39ff88;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 600px) {

        .auth-page {
            padding: 35px 15px 50px;
        }

        .auth-card {
            padding: 23px 20px;
            border-radius: 20px;
        }
    }

</style>

<div class="auth-page">

    
    <div class="auth-wrapper">

        <div class="auth-header">

            <div class="auth-eyebrow">

                <span></span>

                AJACAS ACCESS

            </div>

            <h1>
                Welcome back
            </h1>

            <p>
                Sign in to continue managing your career profile,
                resumes and AI-powered career insights.
            </p>

        </div>

        <div class="auth-card">

            <form asp-action="Login"
                  method="post">

                <input type="hidden"
                       name="returnUrl"
                       value="@ViewData["ReturnUrl"]" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary">
                </div>

                <div class="form-section">

                    <label asp-for="Email"
                           class="form-label">

                        Email Address

                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Email"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-section">

                    <label asp-for="Password"
                           class="form-label">

                        Password

                    </label>

                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Password"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-check">

                    <input asp-for="RememberMe"
                           class="form-check-input" />

                    <label asp-for="RememberMe"
                           class="form-check-label">
                    </label>

                </div>

                <button type="submit"
                        class="auth-button">

                    <i class="bi bi-box-arrow-in-right"></i>

                    Sign In

                </button>

            </form>

            <div class="auth-footer">

                Don't have an account?

                <a asp-action="Register">
                    Create one
                </a>

            </div>

            <div class="security-line">

                <i class="bi bi-shield-check"></i>

                Secure AJACAS authentication

            </div>

        </div>

    </div>
    

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
