
@model IEnumerable<AJACAS.Models.UserSkill>

@{
    ViewData["Title"] = "My Skills";
}



<div class="skills-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ajacas-alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- PAGE HEADER -->
    <div class="skills-header">

        <div>

            <div class="skills-eyebrow">
                <span class="eyebrow-dot"></span>
                PROFESSIONAL SKILLSET
            </div>

            <h1>My Skills</h1>

            <p>
                Manage the technical and professional skills
                that define your career profile.
            </p>

        </div>

        <a asp-action="Create"
           class="add-skill-btn">

            <i class="bi bi-plus-lg"></i>

            <span>Add Skill</span>

        </a>

    </div>


    @if (!Model.Any())
    {
        <!-- EMPTY STATE -->
        <div class="empty-skills-card">

            <div class="empty-icon">
                <i class="bi bi-stars"></i>
            </div>

            <div>

                <h3>No skills added yet</h3>

                <p>
                    Start building your professional profile by
                    adding the skills you have developed.
                </p>

                <a asp-action="Create"
                   class="empty-action">

                    <i class="bi bi-plus-lg"></i>
                    Add Your First Skill

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- SKILLS GRID -->
        <div class="skills-grid">

            @foreach (var userSkill in Model)
            {
                <div class="skill-card">

                    <div class="skill-card-top">

                        <div class="skill-icon">
                            <i class="bi bi-code-slash"></i>
                        </div>

                        <div class="skill-actions">

                            <a asp-action="Edit"
                               asp-route-id="@userSkill.UserSkillId"
                               class="icon-action"
                               title="Edit skill">

                                <i class="bi bi-pencil"></i>

                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@userSkill.UserSkillId"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to remove this skill?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="icon-action delete-action"
                                        title="Delete skill">

                                    <i class="bi bi-trash3"></i>

                                </button>

                            </form>

                        </div>

                    </div>


                    <div class="skill-content">

                        <h3>
                            @userSkill.Skill!.SkillName
                        </h3>

                        @if (!string.IsNullOrWhiteSpace(
                            userSkill.Skill.Category))
                        {
                            <span class="skill-category">

                                <i class="bi bi-tag"></i>

                                @userSkill.Skill.Category

                            </span>
                        }

                    </div>


                    <div class="skill-details">

                        <div class="skill-detail">

                            <span class="detail-label">
                                Proficiency
                            </span>

                            <span class="proficiency-value">

                                <i class="bi bi-bar-chart-fill"></i>

                                @(userSkill.ProficiencyLevel
                                    ?? "Not specified")

                            </span>

                        </div>


                        <div class="skill-detail">

                            <span class="detail-label">
                                Experience
                            </span>

                            <span class="experience-value">

                                @if (userSkill.YearsOfExperience.HasValue)
                                {
                                    @userSkill.YearsOfExperience.Value
                                    @: years
                                }
                                else
                                {
                                    @:Not specified
                                }

                            </span>

                        </div>

                    </div>


                    <div class="skill-card-line"></div>


                    <div class="skill-card-footer">

                        <span>
                            <i class="bi bi-check2-circle"></i>
                            Added to profile
                        </span>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>

    /* =========================================
           AJACAS SKILLS PAGE
           ========================================= */

    .skills-page {
        min-height: 100vh;
        padding: 55px 6% 80px;
        color: #eef3ef;
        animation: pageFadeIn .7s ease both;
    }


    /* =========================================
           ALERT
           ========================================= */

    .ajacas-alert {
        max-width: 1100px;
        margin: 0 auto 30px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border: 1px solid rgba(57,255,136,.2);
        border-radius: 14px;
        background: rgba(57,255,136,.06);
        color: #bfffd5;
        animation: slideDown .5s ease both;
    }

        .ajacas-alert i {
            color: #39ff88;
            font-size: 18px;
        }


    /* =========================================
           HEADER
           ========================================= */

    .skills-header {
        max-width: 1100px;
        margin: 0 auto 42px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
    }


    .skills-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #39ff88;
    }


    .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #39ff88;
        box-shadow: 0 0 12px rgba(57,255,136,.8);
    }


    .skills-header h1 {
        margin: 0;
        font-size: clamp(32px, 4vw, 48px);
        font-weight: 700;
        letter-spacing: -1.5px;
        color: #f4f8f5;
    }


    .skills-header p {
        margin: 12px 0 0;
        max-width: 600px;
        color: #7c8792;
        font-size: 15px;
        line-height: 1.7;
    }


    /* =========================================
           ADD BUTTON
           ========================================= */

    .add-skill-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 19px;
        border-radius: 12px;
        background: #39ff88;
        color: #07100b;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 0 22px rgba(57,255,136,.14);
        transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
    }


        .add-skill-btn:hover {
            color: #07100b;
            transform: translateY(-3px);
            background: #57ff9b;
            box-shadow: 0 8px 28px rgba(57,255,136,.25);
        }


    /* =========================================
           SKILLS GRID
           ========================================= */

    .skills-grid {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }


    /* =========================================
           SKILL CARD
           ========================================= */

    .skill-card {
        position: relative;
        padding: 23px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.07);
        background: linear-gradient( 145deg, rgba(255,255,255,.045), rgba(255,255,255,.018) );
        box-shadow: 0 15px 45px rgba(0,0,0,.12);
        overflow: hidden;
        transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
        animation: cardAppear .6s ease both;
    }


        .skill-card::before {
            content: "";
            position: absolute;
            top: -70px;
            right: -70px;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(57,255,136,.05);
            filter: blur(25px);
            pointer-events: none;
        }


        .skill-card:hover {
            transform: translateY(-6px);
            border-color: rgba(57,255,136,.22);
            box-shadow: 0 18px 50px rgba(0,0,0,.18), 0 0 30px rgba(57,255,136,.04);
        }


    /* =========================================
           CARD TOP
           ========================================= */

    .skill-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 23px;
    }


    .skill-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: rgba(57,255,136,.09);
        border: 1px solid rgba(57,255,136,.15);
        color: #39ff88;
        font-size: 19px;
        box-shadow: 0 0 20px rgba(57,255,136,.05);
    }


    .skill-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }


        .skill-actions form {
            margin: 0;
        }


    .icon-action {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        border: 1px solid rgba(255,255,255,.07);
        background: rgba(255,255,255,.025);
        color: #89939d;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }


        .icon-action:hover {
            color: #39ff88;
            border-color: rgba(57,255,136,.2);
            background: rgba(57,255,136,.07);
            transform: translateY(-2px);
        }


    .delete-action:hover {
        color: #ff6b7a;
        border-color: rgba(255,107,122,.2);
        background: rgba(255,107,122,.06);
    }


    /* =========================================
           CARD CONTENT
           ========================================= */

    .skill-content h3 {
        margin: 0 0 10px;
        color: #f0f5f1;
        font-size: 20px;
        font-weight: 650;
    }


    .skill-category {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 7px;
        background: rgba(255,255,255,.045);
        color: #8d979f;
        font-size: 11px;
        font-weight: 600;
    }


        .skill-category i {
            color: #39ff88;
        }


    /* =========================================
           DETAILS
           ========================================= */

    .skill-details {
        margin-top: 25px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }


    .skill-detail {
        padding: 13px;
        border-radius: 12px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.045);
    }


    .detail-label {
        display: block;
        margin-bottom: 6px;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #66717b;
    }


    .proficiency-value,
    .experience-value {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #dce4de;
        font-size: 12px;
        font-weight: 600;
    }


        .proficiency-value i {
            color: #39ff88;
        }


    /* =========================================
           FOOTER
           ========================================= */

    .skill-card-line {
        height: 1px;
        margin: 20px 0 14px;
        background: rgba(255,255,255,.06);
    }


    .skill-card-footer {
        color: #68737d;
        font-size: 11px;
    }


        .skill-card-footer i {
            margin-right: 5px;
            color: #39ff88;
        }


    /* =========================================
           EMPTY STATE
           ========================================= */

    .empty-skills-card {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 25px;
        padding: 35px;
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,.07);
        background: linear-gradient( 145deg, rgba(255,255,255,.045), rgba(255,255,255,.018) );
        box-shadow: 0 15px 45px rgba(0,0,0,.12);
        animation: cardAppear .7s ease both;
    }


    .empty-icon {
        flex-shrink: 0;
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: rgba(57,255,136,.08);
        border: 1px solid rgba(57,255,136,.14);
        color: #39ff88;
        font-size: 25px;
        box-shadow: 0 0 25px rgba(57,255,136,.06);
    }


    .empty-skills-card h3 {
        margin: 0 0 7px;
        color: #edf3ee;
        font-size: 20px;
    }


    .empty-skills-card p {
        margin: 0 0 17px;
        color: #7c8792;
        font-size: 14px;
    }


    .empty-action {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #39ff88;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: gap .2s ease;
    }


        .empty-action:hover {
            color: #62ffa1;
            gap: 11px;
        }


    /* =========================================
           ANIMATIONS
           ========================================= */

    @@keyframes pageFadeIn {

        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes slideDown {

        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes cardAppear {

        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================
           RESPONSIVE
           ========================================= */

    @@media (max-width: 950px) {

        .skills-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 700px) {

        .skills-page {
            padding: 40px 20px 60px;
        }

        .skills-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .add-skill-btn {
            width: 100%;
            justify-content: center;
        }

        .skills-grid {
            grid-template-columns: 1fr;
        }

        .empty-skills-card {
            align-items: flex-start;
            flex-direction: column;
        }
    }


    @@media (max-width: 500px) {

        .skills-header h1 {
            font-size: 34px;
        }

        .skill-card {
            padding: 19px;
        }

        .skill-details {
            grid-template-columns: 1fr;
        }
    }

</style>
