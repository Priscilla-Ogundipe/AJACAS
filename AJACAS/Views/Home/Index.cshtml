@{
    ViewData["Title"] = "Home";
}

<div class="aj-home">

    <!-- HERO SECTION -->
    <section class="aj-hero">

        <div class="aj-hero-glow glow-one"></div>
        <div class="aj-hero-glow glow-two"></div>

        <div class="container">

            <div class="row align-items-center min-vh-100 py-5">

                <!-- LEFT SIDE -->
                <div class="col-lg-7">

                    <div class="aj-badge">
                        <span class="aj-status-dot"></span>
                        AI-POWERED CAREER INTELLIGENCE
                    </div>

                    <h1 class="aj-hero-title">

                        Build a Resume
                        <span>That Gets Noticed.</span>

                    </h1>

                    <p class="aj-hero-text">

                        AJACAS helps you create stronger resumes, analyze your
                        career profile, identify skill gaps and match your
                        qualifications with job opportunities using AI-powered
                        insights.

                    </p>

                    <div class="aj-hero-actions">

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="aj-btn-primary">

                            <i class="bi bi-rocket-takeoff"></i>

                            Get Started

                        </a>

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="aj-btn-secondary">

                            <i class="bi bi-box-arrow-in-right"></i>

                            Sign In

                        </a>

                    </div>

                    <div class="aj-trust">

                        <div class="aj-trust-item">
                            <i class="bi bi-stars"></i>
                            AI Resume Analysis
                        </div>

                        <div class="aj-trust-item">
                            <i class="bi bi-briefcase"></i>
                            Job Matching
                        </div>

                        <div class="aj-trust-item">
                            <i class="bi bi-graph-up-arrow"></i>
                            Career Insights
                        </div>

                    </div>

                </div>


                <!-- RIGHT SIDE -->
                <div class="col-lg-5">

                    <div class="aj-hero-dashboard">

                        <div class="aj-dashboard-top">

                            <div>
                                <span class="aj-small-label">
                                    CAREER PROFILE
                                </span>

                                <h5>
                                    AI Career Overview
                                </h5>
                            </div>

                            <div class="aj-online">
                                <span></span>
                                AI Active
                            </div>

                        </div>


                        <!-- SCORE -->
                        <div class="aj-score-card">

                            <div class="aj-score-ring">

                                <div class="aj-score-inner">

                                    <strong>87</strong>

                                    <span>/100</span>

                                </div>

                            </div>

                            <div class="aj-score-info">

                                <span>Resume Score</span>

                                <strong>Excellent Profile</strong>

                                <small>
                                    Updated just now
                                </small>

                            </div>

                        </div>


                        <!-- SKILLS -->
                        <div class="aj-mini-card">

                            <div class="aj-mini-header">

                                <span>
                                    <i class="bi bi-lightning-charge"></i>
                                    Skill Profile
                                </span>

                                <strong>82%</strong>

                            </div>

                            <div class="aj-progress">

                                <div class="aj-progress-bar"></div>

                            </div>

                            <div class="aj-skills">

                                <span>C#</span>
                                <span>ASP.NET</span>
                                <span>SQL</span>
                                <span>Python</span>
                                <span>AI/ML</span>

                            </div>

                        </div>


                        <!-- JOB MATCH -->
                        <div class="aj-match-card">

                            <div class="aj-match-icon">
                                <i class="bi bi-briefcase-fill"></i>
                            </div>

                            <div class="aj-match-content">

                                <span>
                                    JOB MATCH
                                </span>

                                <strong>
                                    Backend Developer
                                </strong>

                                <small>
                                    Strong skill alignment
                                </small>

                            </div>

                            <div class="aj-match-percent">
                                92%
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- FEATURES -->
    <section class="aj-features">

        <div class="container py-5">

            <div class="aj-section-heading">

                <span class="aj-section-label">
                    WHAT AJACAS DOES
                </span>

                <h2>
                    Your Career,
                    <span>Powered by Intelligence.</span>
                </h2>

                <p>
                    Everything you need to understand your resume,
                    strengthen your profile and prepare for your next
                    opportunity.
                </p>

            </div>


            <div class="row g-4 mt-4">

                <!-- FEATURE 1 -->
                <div class="col-md-6 col-lg-3">

                    <div class="aj-feature-card">

                        <div class="aj-feature-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>

                        <h4>
                            Resume Management
                        </h4>

                        <p>
                            Upload and manage your resumes in one organized
                            career workspace.
                        </p>

                        <span class="aj-feature-number">
                            01
                        </span>

                    </div>

                </div>


                <!-- FEATURE 2 -->
                <div class="col-md-6 col-lg-3">

                    <div class="aj-feature-card">

                        <div class="aj-feature-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <h4>
                            AI Resume Analysis
                        </h4>

                        <p>
                            Get AI-powered insights into your resume's
                            strengths, weaknesses and improvement areas.
                        </p>

                        <span class="aj-feature-number">
                            02
                        </span>

                    </div>

                </div>


                <!-- FEATURE 3 -->
                <div class="col-md-6 col-lg-3">

                    <div class="aj-feature-card">

                        <div class="aj-feature-icon">
                            <i class="bi bi-bullseye"></i>
                        </div>

                        <h4>
                            Job Matching
                        </h4>

                        <p>
                            Compare your skills and experience against job
                            descriptions to understand your level of match.
                        </p>

                        <span class="aj-feature-number">
                            03
                        </span>

                    </div>

                </div>


                <!-- FEATURE 4 -->
                <div class="col-md-6 col-lg-3">

                    <div class="aj-feature-card">

                        <div class="aj-feature-icon">
                            <i class="bi bi-bar-chart-line"></i>
                        </div>

                        <h4>
                            Career Insights
                        </h4>

                        <p>
                            Track your profile, skills, resume performance
                            and job matching activity.
                        </p>

                        <span class="aj-feature-number">
                            04
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- HOW IT WORKS -->
    <section class="aj-how">

        <div class="container py-5">

            <div class="aj-section-heading">

                <span class="aj-section-label">
                    HOW IT WORKS
                </span>

                <h2>
                    From Resume to
                    <span>Career Insights.</span>
                </h2>

            </div>


            <div class="aj-steps">

                <div class="aj-step">

                    <div class="aj-step-number">
                        01
                    </div>

                    <div class="aj-step-content">

                        <h4>
                            Create Your Profile
                        </h4>

                        <p>
                            Build your career profile by adding your education,
                            experience, projects and skills.
                        </p>

                    </div>

                </div>


                <div class="aj-step">

                    <div class="aj-step-number">
                        02
                    </div>

                    <div class="aj-step-content">

                        <h4>
                            Upload Your Resume
                        </h4>

                        <p>
                            Upload your CV and let AJACAS extract and organize
                            the information from your resume.
                        </p>

                    </div>

                </div>


                <div class="aj-step">

                    <div class="aj-step-number">
                        03
                    </div>

                    <div class="aj-step-content">

                        <h4>
                            Analyze Your Profile
                        </h4>

                        <p>
                            Receive AI-powered analysis covering resume quality,
                            ATS compatibility, content and keywords.
                        </p>

                    </div>

                </div>


                <div class="aj-step">

                    <div class="aj-step-number">
                        04
                    </div>

                    <div class="aj-step-content">

                        <h4>
                            Match With Jobs
                        </h4>

                        <p>
                            Compare your resume against job descriptions and
                            discover matching and missing skills.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="aj-cta">

        <div class="container">

            <div class="aj-cta-box">

                <div class="aj-cta-glow"></div>

                <div class="aj-cta-content">

                    <span class="aj-section-label">
                        START YOUR CAREER JOURNEY
                    </span>

                    <h2>
                        Turn Your Resume Into
                        <span>Career Intelligence.</span>
                    </h2>

                    <p>
                        Create your AJACAS profile and start understanding
                        your career strengths, skill gaps and job matches.
                    </p>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="aj-btn-primary">

                        <i class="bi bi-arrow-right-circle"></i>

                        Create Your Account

                    </a>

                </div>

            </div>

        </div>

    </section>

</div>


<style>

    /* =========================================
           AJACAS HOME PAGE
           ========================================= */

    .aj-home {
        background: radial-gradient(circle at 15% 20%, rgba(57,255,136,.08), transparent 30%), radial-gradient(circle at 85% 15%, rgba(0,255,170,.06), transparent 28%), #050807;
        color: #f2f5f3;
        overflow: hidden;
    }


    /* =========================================
           HERO
           ========================================= */

    .aj-hero {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        overflow: hidden;
    }


    .aj-hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        opacity: .35;
    }


    .glow-one {
        width: 400px;
        height: 400px;
        background: rgba(57,255,136,.12);
        top: 5%;
        left: -150px;
    }


    .glow-two {
        width: 350px;
        height: 350px;
        background: rgba(0,255,170,.08);
        bottom: 0;
        right: -100px;
    }


    .aj-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 9px 15px;
        border: 1px solid rgba(57,255,136,.2);
        background: rgba(57,255,136,.05);
        border-radius: 50px;
        color: #39ff88;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 25px;
        animation: homeFadeUp .8s ease forwards;
    }


    .aj-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #39ff88;
        box-shadow: 0 0 12px #39ff88;
        animation: statusPulse 2s infinite;
    }


    .aj-hero-title {
        max-width: 760px;
        font-size: clamp(3rem, 6vw, 5.8rem);
        line-height: 1.02;
        font-weight: 800;
        letter-spacing: -3px;
        margin-bottom: 25px;
        animation: homeFadeUp .9s ease forwards;
    }


        .aj-hero-title span {
            display: block;
            color: #39ff88;
            text-shadow: 0 0 35px rgba(57,255,136,.12);
        }


    .aj-hero-text {
        max-width: 650px;
        color: #9da9a2;
        font-size: 17px;
        line-height: 1.8;
        margin-bottom: 35px;
        animation: homeFadeUp 1s ease forwards;
    }


    .aj-hero-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        animation: homeFadeUp 1.1s ease forwards;
    }


    .aj-btn-primary,
    .aj-btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 13px 22px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        transition: all .3s ease;
    }


    .aj-btn-primary {
        background: #39ff88;
        color: #031108;
        box-shadow: 0 0 25px rgba(57,255,136,.12);
    }


        .aj-btn-primary:hover {
            color: #031108;
            transform: translateY(-3px);
            box-shadow: 0 10px 35px rgba(57,255,136,.22);
        }


    .aj-btn-secondary {
        color: #e7eee9;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(255,255,255,.03);
    }


        .aj-btn-secondary:hover {
            color: #39ff88;
            border-color: rgba(57,255,136,.4);
            transform: translateY(-3px);
        }


    .aj-trust {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
        margin-top: 30px;
        animation: homeFadeUp 1.2s ease forwards;
    }


    .aj-trust-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #7f8c84;
        font-size: 12px;
    }


        .aj-trust-item i {
            color: #39ff88;
        }


    /* =========================================
           HERO DASHBOARD PREVIEW
           ========================================= */

    .aj-hero-dashboard {
        position: relative;
        padding: 25px;
        border: 1px solid rgba(255,255,255,.09);
        border-radius: 22px;
        background: linear-gradient( 145deg, rgba(255,255,255,.06), rgba(255,255,255,.015) );
        box-shadow: 0 30px 80px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.04);
        backdrop-filter: blur(20px);
        animation: dashboardFloat 5s ease-in-out infinite;
    }


    .aj-dashboard-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }


    .aj-small-label {
        display: block;
        color: #64736a;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 5px;
    }


    .aj-dashboard-top h5 {
        margin: 0;
        font-weight: 700;
    }


    .aj-online {
        color: #39ff88;
        font-size: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }


        .aj-online span {
            width: 6px;
            height: 6px;
            background: #39ff88;
            border-radius: 50%;
            box-shadow: 0 0 10px #39ff88;
        }


    .aj-score-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 20px;
        background: rgba(0,0,0,.25);
        border-radius: 15px;
        border: 1px solid rgba(255,255,255,.05);
        margin-bottom: 14px;
    }


    .aj-score-ring {
        width: 105px;
        height: 105px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: conic-gradient( #39ff88 0deg 313deg, rgba(255,255,255,.07) 313deg 360deg );
        position: relative;
    }


        .aj-score-ring::before {
            content: "";
            position: absolute;
            width: 82px;
            height: 82px;
            border-radius: 50%;
            background: #0b110e;
        }


    .aj-score-inner {
        position: relative;
        z-index: 2;
        text-align: center;
    }


        .aj-score-inner strong {
            display: block;
            font-size: 25px;
            color: #fff;
        }


        .aj-score-inner span {
            color: #68766e;
            font-size: 10px;
        }


    .aj-score-info span,
    .aj-score-info small {
        display: block;
        color: #7e8b83;
    }


    .aj-score-info span {
        font-size: 11px;
    }


    .aj-score-info strong {
        display: block;
        margin: 5px 0;
        color: #39ff88;
    }


    .aj-score-info small {
        font-size: 9px;
    }


    .aj-mini-card,
    .aj-match-card {
        background: rgba(0,0,0,.2);
        border: 1px solid rgba(255,255,255,.05);
        border-radius: 15px;
        padding: 17px;
        margin-bottom: 14px;
    }


    .aj-mini-header {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        margin-bottom: 12px;
    }


        .aj-mini-header i {
            color: #39ff88;
            margin-right: 6px;
        }


        .aj-mini-header strong {
            color: #39ff88;
        }


    .aj-progress {
        height: 5px;
        background: rgba(255,255,255,.07);
        border-radius: 10px;
        overflow: hidden;
    }


    .aj-progress-bar {
        width: 82%;
        height: 100%;
        background: #39ff88;
        border-radius: 10px;
        box-shadow: 0 0 12px rgba(57,255,136,.3);
    }


    .aj-skills {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 13px;
    }


        .aj-skills span {
            padding: 5px 8px;
            background: rgba(57,255,136,.06);
            border: 1px solid rgba(57,255,136,.1);
            border-radius: 6px;
            color: #a9b4ad;
            font-size: 9px;
        }


    .aj-match-card {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 0;
    }


    .aj-match-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: #39ff88;
        background: rgba(57,255,136,.08);
    }


    .aj-match-content {
        flex: 1;
    }


        .aj-match-content span,
        .aj-match-content small {
            display: block;
            color: #68766e;
            font-size: 8px;
        }


        .aj-match-content strong {
            display: block;
            font-size: 12px;
            margin: 3px 0;
        }


    .aj-match-percent {
        color: #39ff88;
        font-size: 18px;
        font-weight: 800;
    }


    /* =========================================
           SECTION
           ========================================= */

    .aj-section-heading {
        text-align: center;
        max-width: 720px;
        margin: auto;
    }


    .aj-section-label {
        color: #39ff88;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
    }


    .aj-section-heading h2 {
        font-size: clamp(2rem, 4vw, 3.2rem);
        font-weight: 800;
        letter-spacing: -1.5px;
        margin: 12px 0 15px;
    }


        .aj-section-heading h2 span {
            color: #39ff88;
        }


    .aj-section-heading p {
        color: #7f8c84;
        line-height: 1.8;
    }


    /* =========================================
           FEATURES
           ========================================= */

    .aj-features {
        padding: 100px 0;
        background: rgba(255,255,255,.015);
        border-top: 1px solid rgba(255,255,255,.04);
        border-bottom: 1px solid rgba(255,255,255,.04);
    }


    .aj-feature-card {
        height: 100%;
        position: relative;
        padding: 25px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 16px;
        overflow: hidden;
        transition: all .35s ease;
    }


        .aj-feature-card:hover {
            transform: translateY(-8px);
            border-color: rgba(57,255,136,.25);
            background: rgba(57,255,136,.035);
            box-shadow: 0 20px 45px rgba(0,0,0,.25);
        }


    .aj-feature-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #39ff88;
        background: rgba(57,255,136,.07);
        font-size: 20px;
        margin-bottom: 20px;
    }


    .aj-feature-card h4 {
        font-size: 17px;
        margin-bottom: 10px;
    }


    .aj-feature-card p {
        color: #7e8b83;
        font-size: 13px;
        line-height: 1.7;
        margin: 0;
    }


    .aj-feature-number {
        position: absolute;
        right: 20px;
        bottom: 12px;
        color: rgba(57,255,136,.07);
        font-size: 50px;
        font-weight: 800;
    }


    /* =========================================
           HOW IT WORKS
           ========================================= */

    .aj-how {
        padding: 100px 0;
    }


    .aj-steps {
        max-width: 850px;
        margin: 60px auto 0;
    }


    .aj-step {
        display: flex;
        gap: 25px;
        padding: 25px 0;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }


    .aj-step-number {
        min-width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid rgba(57,255,136,.25);
        color: #39ff88;
        font-size: 12px;
        font-weight: 800;
    }


    .aj-step-content h4 {
        margin-bottom: 8px;
        font-size: 17px;
    }


    .aj-step-content p {
        color: #7f8c84;
        font-size: 13px;
        line-height: 1.7;
        margin: 0;
    }


    /* =========================================
           CTA
           ========================================= */

    .aj-cta {
        padding: 50px 0 100px;
    }


    .aj-cta-box {
        position: relative;
        overflow: hidden;
        text-align: center;
        padding: 80px 30px;
        border-radius: 25px;
        border: 1px solid rgba(57,255,136,.15);
        background: radial-gradient( circle at center, rgba(57,255,136,.07), rgba(255,255,255,.015) 55% );
    }


    .aj-cta-content {
        position: relative;
        z-index: 2;
        max-width: 700px;
        margin: auto;
    }


        .aj-cta-content h2 {
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 800;
            margin: 15px 0;
        }


            .aj-cta-content h2 span {
                color: #39ff88;
            }


        .aj-cta-content p {
            max-width: 600px;
            margin: 0 auto 30px;
            color: #7f8c84;
            line-height: 1.8;
        }


    /* =========================================
           ANIMATIONS
           ========================================= */

    @@keyframes homeFadeUp {

        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes dashboardFloat {

        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }


    @@keyframes statusPulse {

        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .5;
            transform: scale(.75);
        }
    }


    /* =========================================
           RESPONSIVE
           ========================================= */

    @@media (max-width: 991px) {

        .aj-hero {
            padding-top: 80px;
        }

        .aj-hero-title {
            font-size: 3.7rem;
        }

        .aj-hero-dashboard {
            margin-top: 50px;
        }

        .aj-features,
        .aj-how {
            padding: 70px 0;
        }
    }


    @@media (max-width: 576px) {

        .aj-hero-title {
            font-size: 2.8rem;
            letter-spacing: -1.5px;
        }

        .aj-hero-text {
            font-size: 15px;
        }

        .aj-hero-actions {
            flex-direction: column;
        }

        .aj-btn-primary,
        .aj-btn-secondary {
            width: 100%;
        }

        .aj-trust {
            gap: 12px;
        }

        .aj-hero-dashboard {
            padding: 15px;
        }

        .aj-score-ring {
            width: 85px;
