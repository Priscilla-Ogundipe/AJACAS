@model IEnumerable<AJACAS.Models.Project>

@{
    ViewData["Title"] = "Projects";
}



<div class="project-page">

    
    <!-- HEADER -->
    <div class="project-header">

        <div class="project-header-content">

            <div class="project-icon">
                <i class="bi bi-kanban"></i>
            </div>

            <div>

                <div class="project-eyebrow">
                    <span></span>
                    PROJECT PORTFOLIO
                </div>

                <h1>My Projects</h1>

                <p>
                    Manage your projects, technical work, and portfolio achievements.
                </p>

            </div>

        </div>

        <a asp-action="Create"
           class="project-add-btn">

            <i class="bi bi-plus-lg"></i>
            <span>Add Project</span>

        </a>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="project-alert project-alert-success">

            <div class="alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>
                <strong>Success</strong>
                <p>@TempData["SuccessMessage"]</p>
            </div>

        </div>
    }


    @if (!Model.Any())
    {
        <!-- EMPTY STATE -->

        <div class="project-empty">

            <div class="empty-glow"></div>

            <div class="empty-icon">
                <i class="bi bi-folder2-open"></i>
            </div>

            <h2>No projects yet</h2>

            <p>
                Add projects you have worked on to showcase your technical
                experience and strengthen your career profile.
            </p>

            <a asp-action="Create"
               class="project-primary-btn">

                <i class="bi bi-plus-lg"></i>
                Add Your First Project

            </a>

        </div>
    }
    else
    {
        <!-- PROJECT SUMMARY -->

        <div class="project-summary">

            <div class="summary-item">

                <div class="summary-icon">
                    <i class="bi bi-kanban"></i>
                </div>

                <div>
                    <span>Total Projects</span>
                    <strong>@Model.Count()</strong>
                </div>

            </div>

            <div class="summary-line"></div>

            <div class="summary-item">

                <div class="summary-icon">
                    <i class="bi bi-stars"></i>
                </div>

                <div>
                    <span>Portfolio Status</span>
                    <strong>Up to Date</strong>
                </div>

            </div>

        </div>


        <!-- PROJECT GRID -->

        <div class="project-grid">

            @foreach (var project in Model)
            {
                <div class="project-card">

                    <!-- CARD TOP -->

                    <div class="project-card-top">

                        <div class="document-icon">
                            <i class="bi bi-folder2"></i>
                        </div>

                        <div class="project-card-actions">

                            <a asp-action="Edit"
                               asp-route-id="@project.ProjectId"
                               class="card-icon-btn"
                               title="Edit project">

                                <i class="bi bi-pencil"></i>

                            </a>

                        </div>

                    </div>


                    <!-- PROJECT CONTENT -->

                    <div class="project-card-content">

                        <h3 title="@project.ProjectName">
                            @project.ProjectName
                        </h3>


                        @if (!string.IsNullOrEmpty(project.Description))
                        {
                            <p class="project-description">
                                @project.Description
                            </p>
                        }


                        @if (!string.IsNullOrEmpty(project.Technologies))
                        {
                            <div class="technology-section">

                                <div class="technology-label">
                                    <i class="bi bi-code-slash"></i>
                                    Technologies
                                </div>

                                <p>
                                    @project.Technologies
                                </p>

                            </div>
                        }


                        @if (project.StartDate.HasValue ||
                             project.EndDate.HasValue)
                        {
                            <div class="project-meta">

                                <i class="bi bi-calendar3"></i>

                                <div>

                                    <span>Timeline</span>

                                    <strong>

                                        @if (project.StartDate.HasValue)
                                        {
                                            @project.StartDate.Value.ToString("MMM yyyy")
                                        }

                                        @if (project.EndDate.HasValue)
                                        {
                                            <span> - </span>
                                            @project.EndDate.Value.ToString("MMM yyyy")
                                        }

                                    </strong>

                                </div>

                            </div>
                        }

                    </div>


                    <!-- LINKS -->
                    @if (!string.IsNullOrEmpty(project.ProjectUrl) ||
                                         !string.IsNullOrEmpty(project.GitHubUrl))
                    {
                        <div class="project-links">

                            @if (!string.IsNullOrEmpty(project.ProjectUrl))
                            {
                                <a href="@project.ProjectUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="project-link project-link-primary">

                                    <i class="bi bi-link-45deg"></i>
                                    Project

                                </a>
                            }

                            @if (!string.IsNullOrEmpty(project.GitHubUrl))
                            {
                                <a href="@project.GitHubUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="project-link project-link-secondary">

                                    <i class="bi bi-github"></i>
                                    GitHub

                                </a>
                            }

                        </div>
                    }


                    <!-- CARD FOOTER -->

                    <div class="project-card-footer">

                        <a asp-action="Edit"
                           asp-route-id="@project.ProjectId"
                           class="edit-project-btn">

                            <i class="bi bi-pencil"></i>
                            Edit Project

                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@project.ProjectId"
                              method="post"
                              class="delete-project-form"
                              onsubmit="return confirm('Are you sure you want to delete this project?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="delete-project-btn"
                                    title="Delete project">

                                <i class="bi bi-trash"></i>

                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>


        <!-- BOTTOM INFORMATION -->

        <div class="project-info-banner">

            <div class="info-banner-icon">
                <i class="bi bi-stars"></i>
            </div>

            <div>

                <h4>Showcase your technical experience</h4>

                <p>
                    Keep your projects updated with the technologies,
                    links, and experience that demonstrate what you can build.
                </p>

            </div>

        </div>
    }
    

</div>

<style>

    /* =========================================
           PROJECT PAGE
        ========================================= */

    .project-page {
        min-height: calc(100vh - 80px);
        padding: 45px 5% 70px;
        color: #f5f7f8;
        position: relative;
    }


    /* =========================================
           HEADER
        ========================================= */

    .project-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        margin-bottom: 35px;
    }

    .project-header-content {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .project-icon {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(57,255,136,.08);
        border: 1px solid rgba(57,255,136,.25);
        color: #39ff88;
        font-size: 27px;
        box-shadow: 0 0 30px rgba(57,255,136,.08);
        flex-shrink: 0;
    }

    .project-eyebrow {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #39ff88;
        margin-bottom: 7px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .project-eyebrow span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #39ff88;
            box-shadow: 0 0 10px #39ff88;
        }

    .project-header h1 {
        margin: 0;
        font-size: clamp(28px,4vw,40px);
        font-weight: 800;
        letter-spacing: -1px;
    }

    .project-header p {
        margin: 7px 0 0;
        color: #89939f;
        font-size: 14px;
    }


    /* =========================================
           ADD BUTTON
        ========================================= */

    .project-add-btn,
    .project-primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        text-decoration: none;
        background: #39ff88;
        color: #06100a;
        border: none;
        font-weight: 700;
        padding: 13px 20px;
        border-radius: 12px;
        transition: all .25s ease;
        box-shadow: 0 8px 30px rgba(57,255,136,.12);
    }

        .project-add-btn:hover,
        .project-primary-btn:hover {
            color: #06100a;
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(57,255,136,.22);
        }


    /* =========================================
           ALERT
        ========================================= */

    .project-alert {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 18px;
        margin-bottom: 25px;
        border-radius: 14px;
        backdrop-filter: blur(15px);
        animation: projectFadeIn .5s ease;
    }

    .project-alert-success {
        background: rgba(57,255,136,.07);
        border: 1px solid rgba(57,255,136,.2);
    }

    .project-alert .alert-icon {
        font-size: 21px;
        color: #39ff88;
    }

    .project-alert strong {
        display: block;
        font-size: 14px;
    }

    .project-alert p {
        margin: 2px 0 0;
        color: #89939f;
        font-size: 13px;
    }


    /* =========================================
           SUMMARY
        ========================================= */

    .project-summary {
        display: flex;
        align-items: center;
        width: fit-content;
        min-width: 390px;
        margin-bottom: 30px;
        padding: 17px 22px;
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 16px;
        background: rgba(255,255,255,.025);
        backdrop-filter: blur(20px);
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .summary-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #39ff88;
        background: rgba(57,255,136,.08);
    }

    .summary-item span {
        display: block;
        font-size: 11px;
        color: #7e8995;
        margin-bottom: 3px;
    }

    .summary-item strong {
        font-size: 14px;
    }

    .summary-line {
        width: 1px;
        height: 35px;
        background: rgba(255,255,255,.08);
        margin: 0 28px;
    }


    /* =========================================
           PROJECT GRID
        ========================================= */

    .project-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 22px;
    }


    /* =========================================
           PROJECT CARD
        ========================================= */

    .project-card {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        background: linear-gradient( 145deg, rgba(255,255,255,.045), rgba(255,255,255,.018) );
        border: 1px solid rgba(255,255,255,.075);
        backdrop-filter: blur(20px);
        transition: all .3s ease;
        animation: projectCardIn .55s ease both;
        display: flex;
        flex-direction: column;
    }

        .project-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 1px;
            background: linear-gradient( 90deg, transparent, rgba(57,255,136,.45), transparent );
            opacity: .5;
        }

        .project-card:hover {
            transform: translateY(-7px);
            border-color: rgba(57,255,136,.22);
            box-shadow: 0 20px 50px rgba(0,0,0,.28), 0 0 30px rgba(57,255,136,.05);
        }


    /* =========================================
           CARD TOP
        ========================================= */

    .project-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 22px 0;
    }

    .document-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(57,255,136,.07);
        border: 1px solid rgba(57,255,136,.12);
        color: #39ff88;
        font-size: 21px;
    }

    .project-card-actions {
        display: flex;
        gap: 7px;
    }

    .card-icon-btn {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #89939d;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        text-decoration: none;
        transition: all .25s ease;
    }

        .card-icon-btn:hover {
            color: #39ff88;
            border-color: rgba(57,255,136,.25);
            background: rgba(57,255,136,.06);
        }


    /* =========================================
           CARD CONTENT
        ========================================= */

    .project-card-content {
        padding: 20px 22px;
        flex: 1;
    }

        .project-card-content h3 {
            margin: 0 0 10px;
            font-size: 18px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .project-description {
        color: #818c97;
        font-size: 12px;
        line-height: 1.7;
        margin: 0 0 20px;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .technology-section {
        margin-bottom: 19px;
        padding: 12px 13px;
        border-radius: 11px;
        background: rgba(57,255,136,.025);
        border: 1px solid rgba(57,255,136,.07);
    }

    .technology-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 5px;
        color: #39ff88;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    .technology-section p {
        margin: 0;
        color: #aab2b8;
        font-size: 11px;
        line-height: 1.6;
    }


    /* =========================================
           META
        ========================================= */

    .project-meta {
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .project-meta > i {
            color: #64717d;
            font-size: 14px;
        }

        .project-meta span {
            display: block;
            color: #66727e;
            font-size: 10px;
            margin-bottom: 2px;
        }

        .project-meta strong {
            color: #c7cdd2;
            font-size: 11px;
            font-weight: 600;
        }


    /* =========================================
           PROJECT LINKS
        ========================================= */

    .project-links {
        display: flex;
        gap: 8px;
        padding: 0 22px 18px;
    }

    .project-link {
        flex: 1;
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: all .25s ease;
    }

    .project-link-primary {
        color: #39ff88;
        border: 1px solid rgba(57,255,136,.16);
        background: rgba(57,255,136,.045);
    }

        .project-link-primary:hover {
            color: #06100a;
            background: #39ff88;
            border-color: #39ff88;
        }

    .project-link-secondary {
        color: #cbd2d7;
        border: 1px solid rgba(255,255,255,.09);
        background: rgba(255,255,255,.025);
    }

        .project-link-secondary:hover {
            color: #fff;
            border-color: rgba(255,255,255,.2);
            background: rgba(255,255,255,.06);
        }


    /* =========================================
           CARD FOOTER
        ========================================= */

    .project-card-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 22px 22px;
    }

    .edit-project-btn {
        flex: 1;
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 10px;
        color: #cbd2d7;
        border: 1px solid rgba(255,255,255,.09);
        background: rgba(255,255,255,.025);
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: all .25s ease;
    }

        .edit-project-btn:hover {
            color: #fff;
            border-color: rgba(255,255,255,.2);
            background: rgba(255,255,255,.06);
        }

    .delete-project-form {
        margin: 0;
    }

    .delete-project-btn {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: #ff7777;
        border: 1px solid rgba(255,70,70,.12);
        background: rgba(255,70,70,.035);
        cursor: pointer;
        transition: all .25s ease;
    }

        .delete-project-btn:hover {
            color: #fff;
            background: #ff5f5f;
            border-color: #ff5f5f;
            transform: translateY(-2px);
            box-shadow: 0 7px 20px rgba(255,70,70,.14);
        }


    /* =========================================
           EMPTY STATE
        ========================================= */

    .project-empty {
        position: relative;
        overflow: hidden;
        text-align: center;
        padding: 75px 25px;
        border-radius: 24px;
        border: 1px dashed rgba(255,255,255,.12);
        background: rgba(255,255,255,.02);
    }

    .empty-glow {
        position: absolute;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: rgba(57,255,136,.07);
        filter: blur(80px);
        top: -130px;
        left: 50%;
        transform: translateX(-50%);
    }

    .empty-icon {
        position: relative;
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #39ff88;
        font-size: 31px;
        background: rgba(57,255,136,.07);
        border: 1px solid rgba(57,255,136,.15);
    }

    .project-empty h2 {
        position: relative;
        font-size: 24px;
        margin-bottom: 10px;
    }

    .project-empty p {
        position: relative;
        max-width: 500px;
        margin: 0 auto 25px;
        color: #818c98;
        font-size: 14px;
        line-height: 1.7;
    }

    .project-primary-btn {
        position: relative;
    }


    /* =========================================
           INFO BANNER
        ========================================= */

    .project-info-banner {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-top: 30px;
        padding: 20px 23px;
        border-radius: 17px;
        background: rgba(57,255,136,.035);
        border: 1px solid rgba(57,255,136,.1);
    }

    .info-banner-icon {
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #39ff88;
        background: rgba(57,255,136,.08);
    }

    .project-info-banner h4 {
        margin: 0 0 4px;
        font-size: 14px;
    }

    .project-info-banner p {
        margin: 0;
        color: #7d8791;
        font-size: 12px;
        line-height: 1.6;
    }


    /* =========================================
           ANIMATIONS
        ========================================= */

    @@keyframes projectFadeIn {

        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes projectCardIn {

        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================
           MOBILE
        ========================================= */

    @@media (max-width: 768px) {

        .project-page {
            padding: 30px 18px 50px;
        }

        .project-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .project-add-btn {
            width: 100%;
        }

        .project-summary {
            width: 100%;
            min-width: 0;
        }

        .project-card-footer {
            padding-bottom: 20px;
        }

        .project-info-banner {
            align-items: flex-start;
        }
    }


    @@media (max-width: 480px) {

        .project-header-content {
            align-items: flex-start;
        }

        .project-icon {
            width: 50px;
            height: 50px;
            font-size: 21px;
            border-radius: 14px;
        }

        .project-header h1 {
            font-size: 28px;
        }

        .project-summary {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .summary-line {
            width: 100%;
            height: 1px;
            margin: 0;
        }

        .project-links {
            flex-direction: column;
        }
    }

</style>
