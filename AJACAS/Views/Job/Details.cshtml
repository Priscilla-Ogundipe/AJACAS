@model AJACAS.Models.JobDescription

@{
    ViewData["Title"] = "Job Details";
}

@await Html.PartialAsync("BackButton")

<style>

    .job-details-page {
        min-height: 100vh;
        padding: 45px 20px 70px;
        color: #f2f5f3;
    }

    .details-wrapper {
        max-width: 1050px;
        margin: 0 auto;
    }

    .details-header {
        margin-bottom: 30px;
        animation: fadeUp .6s ease both;
    }

    .job-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #39ff88;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

        .job-eyebrow span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #39ff88;
            box-shadow: 0 0 12px rgba(57,255,136,.8);
        }

    .details-header h1 {
        font-size: clamp(2rem, 4vw, 3.1rem);
        font-weight: 700;
        letter-spacing: -1px;
        margin-bottom: 10px;
    }

    .company-name {
        color: #39ff88;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .location-text {
        color: #7c8792;
        font-size: .9rem;
    }

    .job-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
    }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 9px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(255,255,255,.07);
        color: #9da8a1;
        font-size: .78rem;
    }

        .meta-chip i {
            color: #39ff88;
        }

    .glass-card {
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 23px;
        box-shadow: 0 20px 60px rgba(0,0,0,.18);
        backdrop-filter: blur(16px);
        animation: fadeUp .7s ease both;
    }

    .description-card {
        padding: 30px;
        margin-bottom: 22px;
    }

    .section-eyebrow {
        color: #39ff88;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .section-title {
        font-size: 1.25rem;
        font-weight: 650;
        margin-bottom: 20px;
    }

    .job-description {
        color: #aeb8b1;
        line-height: 1.85;
        font-size: .94rem;
        white-space: pre-line;
    }

    .date-label {
        color: #69746d;
        font-size: .78rem;
    }

    .date-value {
        color: #aab4ae;
        font-size: .82rem;
    }

    .alert-glass {
        border-radius: 14px;
        padding: 14px 17px;
        margin-bottom: 18px;
        background: rgba(57,255,136,.045);
        border: 1px solid rgba(57,255,136,.15);
        color: #b9c6be;
    }

    .alert-error {
        background: rgba(255,70,70,.05);
        border-color: rgba(255,70,70,.18);
    }

        .alert-error strong {
            color: #ff7777;
        }

    .action-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 25px;
    }

    .neon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid #39ff88;
        background: #39ff88;
        color: #07100b;
        font-weight: 700;
        border-radius: 11px;
        padding: 11px 20px;
        text-decoration: none;
        transition: .25s ease;
    }

        .neon-btn:hover {
            color: #07100b;
            transform: translateY(-2px);
            box-shadow: 0 0 28px rgba(57,255,136,.25);
        }

    .outline-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid rgba(255,255,255,.13);
        background: rgba(255,255,255,.025);
        color: #b8c1bb;
        font-weight: 600;
        border-radius: 11px;
        padding: 11px 20px;
        text-decoration: none;
        transition: .25s ease;
    }

        .outline-btn:hover {
            color: #fff;
            border-color: rgba(57,255,136,.35);
            background: rgba(57,255,136,.05);
            transform: translateY(-2px);
        }

    .danger-btn {
        border-color: rgba(255,80,80,.3);
        color: #ff8585;
    }

        .danger-btn:hover {
            color: #ff9b9b;
            border-color: rgba(255,80,80,.55);
            background: rgba(255,80,80,.05);
        }

    .match-card {
        position: relative;
        overflow: hidden;
        padding: 32px;
        border-radius: 23px;
        background: radial-gradient(circle at 90% 20%, rgba(57,255,136,.08), transparent 35%), rgba(255,255,255,.025);
        border: 1px solid rgba(57,255,136,.16);
        box-shadow: 0 20px 70px rgba(57,255,136,.05);
        animation: fadeUp .85s ease both;
    }

    .match-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: rgba(57,255,136,.08);
        border: 1px solid rgba(57,255,136,.18);
        color: #39ff88;
        font-size: 1.4rem;
        margin-bottom: 18px;
        box-shadow: 0 0 25px rgba(57,255,136,.06);
    }

    .match-card h3 {
        font-size: 1.35rem;
        margin-bottom: 8px;
    }

    .match-card p {
        color: #7c8792;
        max-width: 700px;
        line-height: 1.7;
        margin-bottom: 22px;
    }

    .match-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 22px;
        border-radius: 11px;
        background: #39ff88;
        color: #07100b;
        text-decoration: none;
        font-weight: 700;
        transition: .25s ease;
    }

        .match-btn:hover {
            color: #07100b;
            transform: translateY(-3px);
            box-shadow: 0 0 30px rgba(57,255,136,.3);
        }

    .match-note {
        color: #626d67;
        font-size: .76rem;
        margin-top: 12px;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 700px) {

        .job-details-page {
            padding: 30px 15px 50px;
        }

        .description-card,
        .match-card {
            padding: 23px;
            border-radius: 19px;
        }

        .action-row {
            flex-direction: column;
        }

            .action-row a,
            .action-row form,
            .action-row button {
                width: 100%;
            }

            .action-row form {
                display: block;
            }

                .action-row form button {
                    width: 100%;
                }
    }

</style>


<div class="job-details-page">

    <div class="details-wrapper">

        <div class="details-header">

            <div class="job-eyebrow">
                <span></span>
                JOB INTELLIGENCE
            </div>

            <h1>
                @Model.JobTitle
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
            {
                <div class="company-name">
                    <i class="bi bi-building"></i>
                    @Model.CompanyName
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <div class="location-text">
                    <i class="bi bi-geo-alt"></i>
                    @Model.Location
                </div>
            }

            <div class="job-meta">

                <div class="meta-chip">
                    <i class="bi bi-calendar3"></i>
                    Added @Model.CreatedAt.ToString("MMM dd, yyyy")
                </div>

                <div class="meta-chip">
                    <i class="bi bi-file-earmark-text"></i>
                    Job Description
                </div>

            </div>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-glass">

                <i class="bi bi-check-circle"
                   style="color:#39ff88;"></i>

                @TempData["SuccessMessage"]

            </div>
        }


        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-glass alert-error">

                <strong>
                    <i class="bi bi-exclamation-triangle"></i>
                    Matching failed:
                </strong>

                @TempData["ErrorMessage"]

            </div>
        }


        <div class="glass-card description-card">

            <div class="section-eyebrow">
                Opportunity Details
            </div>

            <div class="section-title">
                <i class="bi bi-file-earmark-text"
                   style="color:#39ff88;"></i>

                Job Description
            </div>

            <div class="job-description">
                @Model.Description
            </div>

        </div>


        <div class="action-row">

            <a asp-action="Edit"
               asp-route-id="@Model.JobDescriptionId"
               class="neon-btn">

                <i class="bi bi-pencil"></i>
                Edit Job

            </a>


            <form asp-action="Delete"
                  asp-route-id="@Model.JobDescriptionId"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete this job description?');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="outline-btn danger-btn">

                    <i class="bi bi-trash"></i>
                    Delete

                </button>

            </form>

        </div>


        <div class="match-card">

            <div class="match-icon">
                <i class="bi bi-stars"></i>
            </div>

            <div class="section-eyebrow">
                AI CAREER MATCH
            </div>

            <h3>
                Ready to check your suitability?
            </h3>

            <p>
                AJACAS will compare this job with your CV,
                skills, experience and education to identify
                how well your professional profile aligns
                with this opportunity.
            </p>

            <a asp-action="Match"
               asp-route-id="@Model.JobDescriptionId"
               class="match-btn">

                <i class="bi bi-stars"></i>
                Match With My CV

            </a>

            <div class="match-note">
                Compare your CV with this job description.
            </div>

        </div>

    </div>

</div>