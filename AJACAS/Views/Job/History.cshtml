@model IEnumerable<AJACAS.Models.JobMatch>

@{
    ViewData["Title"] = "Job Match History";
}

@await Html.PartialAsync("BackButton")

<style>

    .match-history-page {
        min-height: 100vh;
        padding: 45px 20px 70px;
        color: #f2f5f3;
    }

    .history-wrapper {
        max-width: 1100px;
        margin: 0 auto;
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 30px;
        animation: fadeUp .6s ease both;
    }

    .history-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #39ff88;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

        .history-eyebrow span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #39ff88;
            box-shadow: 0 0 12px rgba(57,255,136,.8);
        }

    .history-header h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -1px;
        margin-bottom: 9px;
    }

    .history-header p {
        color: #7c8792;
        margin: 0;
        line-height: 1.6;
    }

    .neon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid #39ff88;
        background: #39ff88;
        color: #07100b;
        font-weight: 700;
        border-radius: 11px;
        padding: 11px 19px;
        text-decoration: none;
        transition: .25s ease;
        white-space: nowrap;
    }

        .neon-btn:hover {
            color: #07100b;
            transform: translateY(-2px);
            box-shadow: 0 0 28px rgba(57,255,136,.25);
        }

    .outline-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid rgba(255,255,255,.13);
        background: rgba(255,255,255,.025);
        color: #b8c1bb;
        font-weight: 600;
        border-radius: 10px;
        padding: 9px 15px;
        text-decoration: none;
        transition: .25s ease;
    }

        .outline-btn:hover {
            color: #fff;
            border-color: rgba(57,255,136,.35);
            background: rgba(57,255,136,.05);
            transform: translateY(-2px);
        }

    .history-alert {
        background: rgba(57,255,136,.045);
        border: 1px solid rgba(57,255,136,.15);
        border-radius: 13px;
        padding: 13px 17px;
        color: #b9c6be;
        margin-bottom: 22px;
        animation: fadeUp .65s ease both;
    }

        .history-alert i {
            color: #39ff88;
        }

    .match-card {
        position: relative;
        overflow: hidden;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 22px;
        padding: 25px;
        margin-bottom: 17px;
        backdrop-filter: blur(15px);
        box-shadow: 0 18px 55px rgba(0,0,0,.17);
        transition: .3s ease;
        animation: fadeUp .7s ease both;
    }

        .match-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            background: #39ff88;
            opacity: .7;
        }

        .match-card:hover {
            transform: translateY(-4px);
            border-color: rgba(57,255,136,.18);
            box-shadow: 0 22px 65px rgba(57,255,136,.055);
        }

    .job-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: rgba(57,255,136,.07);
        border: 1px solid rgba(57,255,136,.14);
        color: #39ff88;
        font-size: 1.25rem;
        margin-bottom: 15px;
    }

    .job-title {
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .company-name {
        color: #39ff88;
        font-size: .88rem;
        margin-bottom: 13px;
    }

    .match-meta {
        color: #69746d;
        font-size: .76rem;
        line-height: 1.7;
    }

        .match-meta i {
            color: #78847d;
            margin-right: 4px;
        }

    .score-column {
        text-align: center;
    }

    .score-label {
        color: #69746d;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: .66rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .score-ring {
        --score: 0;
        width: 92px;
        height: 92px;
        border-radius: 50%;
        background: conic-gradient( #39ff88 calc(var(--score) * 1%), rgba(255,255,255,.07) 0 );
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 0 25px rgba(57,255,136,.06);
    }

    .score-inner {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #0d1310;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #39ff88;
        font-weight: 700;
        font-size: 1rem;
    }

    .skills-section {
        border-top: 1px solid rgba(255,255,255,.06);
        margin-top: 22px;
        padding-top: 18px;
    }

    .skills-title {
        color: #dce4df;
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        margin-bottom: 9px;
    }

    .skills-text {
        color: #7c8792;
        font-size: .84rem;
        line-height: 1.7;
        margin: 0;
    }

    .danger-btn {
        border-color: rgba(255,80,80,.25);
        color: #ff8585;
    }

        .danger-btn:hover {
            color: #ff9b9b;
            border-color: rgba(255,80,80,.5);
            background: rgba(255,80,80,.05);
        }

    .empty-card {
        text-align: center;
        padding: 65px 25px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 23px;
        animation: fadeUp .7s ease both;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        border-radius: 20px;
        background: rgba(57,255,136,.06);
        border: 1px solid rgba(57,255,136,.14);
        color: #39ff88;
        font-size: 1.7rem;
    }

    .empty-card h3 {
        font-size: 1.25rem;
        margin-bottom: 8px;
    }

    .empty-card p {
        color: #7c8792;
        max-width: 520px;
        margin: 0 auto 22px;
        line-height: 1.7;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 800px) {

        .history-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .history-header .neon-btn {
                width: 100%;
            }

        .score-column {
            text-align: left;
            margin-top: 22px;
        }

        .score-ring {
            margin-left: 0;
        }
    }

    @@media (max-width: 600px) {

        .match-history-page {
            padding: 30px 15px 50px;
        }

        .match-card {
            padding: 21px;
            border-radius: 19px;
        }
    }

</style>


<div class="match-history-page">

    <div class="history-wrapper">

        <div class="history-header">

            <div>

                <div class="history-eyebrow">
                    <span></span>
                    AI CAREER INTELLIGENCE
                </div>

                <h1>
                    Job Match History
                </h1>

                <p>
                    Review your previous CV-to-job matching results
                    and track how your profile aligns with opportunities.
                </p>

            </div>

            <a asp-controller="Job"
               asp-action="Index"
               class="neon-btn">

                <i class="bi bi-search"></i>
                Find a Job

            </a>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="history-alert">

                <i class="bi bi-check-circle"></i>

                @TempData["SuccessMessage"]

            </div>
        }


        @if (Model.Any())
        {
            foreach (var match in Model)
            {
                var score = match.MatchPercentage ?? 0;

                <div class="match-card">

                    <div class="row align-items-center">

                        <div class="col-lg-7">

                            <div class="job-icon">
                                <i class="bi bi-briefcase"></i>
                            </div>

                            <div class="job-title">

                                @(match.JobDescription?.JobTitle
                                    ?? "Unknown Job")

                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                match.JobDescription?.CompanyName))
                            {
                                <div class="company-name">

                                    <i class="bi bi-building"></i>

                                    @match.JobDescription.CompanyName

                                </div>
                            }

                            <div class="match-meta">

                                <div>
                                    <i class="bi bi-file-earmark-text"></i>

                                    Resume:
                                    @(match.Resume?.ResumeName
                                        ?? "Unknown Resume")
                                </div>

                                <div>
                                    <i class="bi bi-clock"></i>

                                    Analyzed:
                                    @match.CreatedAt
                                </div>

                            </div>

                        </div>


                        <div class="col-lg-2 score-column">

                            <div class="score-label">
                                Match Score
                            </div>

                            <div class="score-ring"
                                 style="--score:@score;">

                                <div class="score-inner">

                                    @(match.MatchPercentage.HasValue
                                        ? match.MatchPercentage.Value
                                            .ToString("0.##") + "%"
                                        : "N/A")

                                </div>

                            </div>

                        </div>


                        <div class="col-lg-3 mt-4 mt-lg-0">

                            <div class="d-flex flex-column gap-2">

                                <a asp-controller="Job"
                                   asp-action="MatchResult"
                                   asp-route-id="@match.JobMatchId"
                                   class="neon-btn">

                                    <i class="bi bi-bar-chart-line"></i>
                                    View Result

                                </a>


                                <form asp-controller="Job"
                                      asp-action="DeleteMatch"
                                      asp-route-id="@match.JobMatchId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="outline-btn danger-btn w-100"
                                            onclick="return confirm('Are you sure you want to delete this match?');">

                                        <i class="bi bi-trash"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(match.MatchedSkills))
                    {
                        <div class="skills-section">

                            <div class="skills-title">
                                <i class="bi bi-stars"
                                   style="color:#39ff88;"></i>

                                Matched Skills
                            </div>

                            <p class="skills-text">
                                @match.MatchedSkills
                            </p>

                        </div>
                    }

                </div>
            }
        }
        else
        {
            <div class="empty-card">

                <div class="empty-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </div>

                <h3>
                    No Job Matches Yet
                </h3>

                <p>
                    You haven't analyzed any jobs yet.
                    Start by selecting a job and matching it
                    with one of your resumes.
                </p>

                <a asp-controller="Job"
                   asp-action="Index"
                   class="neon-btn">

                    <i class="bi bi-stars"></i>
                    Start Job Matching

                </a>

            </div>
        }

    </div>

</div>