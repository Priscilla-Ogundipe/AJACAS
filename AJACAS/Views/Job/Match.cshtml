@model IEnumerable<AJACAS.Models.Resume>

@{
    ViewData["Title"] = "Match CV With Job";
    var job = ViewBag.Job as AJACAS.Models.JobDescription;
}

@await Html.PartialAsync("BackButton")

<style>

    .match-page {
        min-height: 100vh;
        padding: 45px 20px 70px;
        color: #f2f5f3;
    }

    .match-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    .match-header {
        margin-bottom: 30px;
        animation: fadeUp .6s ease both;
    }

    .match-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #39ff88;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 11px;
    }

        .match-eyebrow span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #39ff88;
            box-shadow: 0 0 12px rgba(57,255,136,.8);
        }

    .match-header h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -1px;
        margin-bottom: 10px;
    }

    .match-header p {
        color: #7c8792;
        line-height: 1.7;
        margin-bottom: 5px;
    }

    .job-context {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #39ff88;
        font-size: .9rem;
        font-weight: 600;
    }

        .job-context span {
            color: #69746d;
        }

    .selection-card {
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 23px;
        padding: 30px;
        backdrop-filter: blur(15px);
        box-shadow: 0 20px 60px rgba(0,0,0,.18);
        animation: fadeUp .7s ease both;
    }

    .section-eyebrow {
        color: #39ff88;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .selection-title {
        font-size: 1.3rem;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .selection-description {
        color: #7c8792;
        line-height: 1.7;
        margin-bottom: 25px;
    }

    .resume-option {
        position: relative;
        margin-bottom: 13px;
    }

        .resume-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .resume-label {
        display: flex;
        align-items: center;
        gap: 15px;
        width: 100%;
        padding: 18px;
        border-radius: 16px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.08);
        cursor: pointer;
        transition: .25s ease;
    }

        .resume-label:hover {
            border-color: rgba(57,255,136,.3);
            background: rgba(57,255,136,.035);
            transform: translateX(3px);
        }

    .resume-option input:checked + .resume-label {
        border-color: #39ff88;
        background: rgba(57,255,136,.055);
        box-shadow: 0 0 25px rgba(57,255,136,.06);
    }

    .resume-radio {
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.22);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .25s ease;
    }

    .resume-option input:checked + .resume-label .resume-radio {
        border-color: #39ff88;
        box-shadow: 0 0 12px rgba(57,255,136,.3);
    }

        .resume-option input:checked + .resume-label .resume-radio::after {
            content: "";
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #39ff88;
        }

    .resume-icon {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(57,255,136,.07);
        border: 1px solid rgba(57,255,136,.13);
        color: #39ff88;
        font-size: 1.1rem;
    }

    .resume-info {
        min-width: 0;
        flex: 1;
    }

    .resume-name {
        display: block;
        color: #e6ece8;
        font-size: .92rem;
        font-weight: 650;
        margin-bottom: 4px;
    }

    .resume-meta {
        color: #68736c;
        font-size: .74rem;
    }

    .active-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: #39ff88;
        background: rgba(57,255,136,.07);
        border: 1px solid rgba(57,255,136,.14);
        padding: 4px 8px;
        border-radius: 7px;
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .match-actions {
        display: flex;
        gap: 11px;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .neon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid #39ff88;
        background: #39ff88;
        color: #07100b;
        font-weight: 700;
        border-radius: 11px;
        padding: 11px 20px;
        text-decoration: none;
        transition: .25s ease;
    }

        .neon-btn:hover {
            color: #07100b;
            transform: translateY(-2px);
            box-shadow: 0 0 28px rgba(57,255,136,.25);
        }

    .outline-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid rgba(255,255,255,.13);
        background: rgba(255,255,255,.025);
        color: #b8c1bb;
        font-weight: 600;
        border-radius: 11px;
        padding: 11px 20px;
        text-decoration: none;
        transition: .25s ease;
    }

        .outline-btn:hover {
            color: #fff;
            border-color: rgba(57,255,136,.35);
            background: rgba(57,255,136,.05);
            transform: translateY(-2px);
        }

    .empty-state {
        text-align: center;
        padding: 55px 25px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 23px;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        border-radius: 19px;
        background: rgba(57,255,136,.06);
        border: 1px solid rgba(57,255,136,.13);
        color: #39ff88;
        font-size: 1.5rem;
    }

    .empty-state p {
        color: #7c8792;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 600px) {

        .match-page {
            padding: 30px 15px 50px;
        }

        .selection-card {
            padding: 21px;
            border-radius: 19px;
        }

        .resume-label {
            padding: 15px;
        }

        .active-badge {
            display: none;
        }

        .match-actions {
            flex-direction: column;
        }

            .match-actions a,
            .match-actions button {
                width: 100%;
            }
    }

</style>


<div class="match-page">

    <div class="match-wrapper">

        <div class="match-header">

            <div class="match-eyebrow">
                <span></span>
                AI CAREER MATCH
            </div>

            <h1>
                Match Your CV With This Job
            </h1>

            @if (job != null)
            {
                <p>
                    Select the CV you want AJACAS to analyze against this opportunity.
                </p>

                <div class="job-context">

                    <i class="bi bi-briefcase"></i>

                    @job.JobTitle

                    @if (!string.IsNullOrWhiteSpace(job.CompanyName))
                    {
                        <span>·</span>
                        <span>@job.CompanyName</span>
                    }

                </div>
            }

        </div>


        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-file-earmark-x"></i>
                </div>

                <h3>
                    No CVs Available
                </h3>

                <p>
                    You need to upload a CV before AJACAS can
                    compare your profile with this job.
                </p>

            </div>
        }
        else
        {
            <div class="selection-card">

                <div class="section-eyebrow">
                    RESUME SELECTION
                </div>

                <div class="selection-title">
                    Select a CV
                </div>

                <p class="selection-description">
                    Choose the CV you want AJACAS to compare
                    with this job description.
                </p>


                <form asp-action="RunMatch"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="jobDescriptionId"
                           value="@job?.JobDescriptionId" />


                    @foreach (var resume in Model)
                    {
                        <div class="resume-option">

                            <input class="form-check-input"
                                   type="radio"
                                   name="resumeId"
                                   value="@resume.ResumeId"
                                   id="resume_@resume.ResumeId"
                                   required />

                            <label class="resume-label"
                                   for="resume_@resume.ResumeId">

                                <span class="resume-radio"></span>

                                <span class="resume-icon">
                                    <i class="bi bi-file-earmark-text"></i>
                                </span>

                                <span class="resume-info">

                                    <span class="resume-name">
                                        @resume.ResumeName
                                    </span>

                                    <span class="resume-meta">

                                        Uploaded:
                                        @resume.UploadedAt.ToLocalTime()

                                    </span>

                                </span>


                                @if (resume.IsActive)
                                {
                                    <span class="active-badge">

                                        <i class="bi bi-check-circle"></i>
                                        Active

                                    </span>
                                }

                            </label>

                        </div>
                    }


                    <div class="match-actions">

                        <button type="submit"
                                class="neon-btn">

                            <i class="bi bi-stars"></i>
                            Analyze Match

                        </button>


                        <a asp-action="Details"
                           asp-route-id="@job?.JobDescriptionId"
                           class="outline-btn">

                            <i class="bi bi-arrow-left"></i>
                            Cancel

                        </a>

                    </div>

                </form>

            </div>
        }

    </div>

</div>