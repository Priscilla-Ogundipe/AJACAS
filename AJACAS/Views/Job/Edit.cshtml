@model AJACAS.ViewModels.JobDescriptionViewModel

@{
    ViewData["Title"] = "Edit Job Description";
}

@await Html.PartialAsync("BackButton")

<style>

    .job-page {
        min-height: 100vh;
        padding: 45px 20px 70px;
        color: #f2f5f3;
    }

    .job-form-wrapper {
        max-width: 850px;
        margin: 0 auto;
    }

    .job-header {
        margin-bottom: 30px;
        animation: fadeUp .6s ease both;
    }

    .job-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #39ff88;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

        .job-eyebrow span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #39ff88;
            box-shadow: 0 0 12px rgba(57,255,136,.8);
        }

    .job-header h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        letter-spacing: -1px;
        margin-bottom: 10px;
    }

    .job-header p {
        color: #7c8792;
        max-width: 650px;
        margin: 0;
        line-height: 1.7;
    }

    .job-form-card {
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 20px 60px rgba(0,0,0,.2);
        backdrop-filter: blur(16px);
        animation: fadeUp .7s ease both;
        transition: .3s ease;
    }

        .job-form-card:hover {
            border-color: rgba(57,255,136,.16);
            box-shadow: 0 20px 70px rgba(57,255,136,.06);
        }

    .form-section-title {
        color: #39ff88;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    .job-field {
        margin-bottom: 22px;
    }

        .job-field label {
            color: #dce4df;
            font-size: .88rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .job-field .form-control {
            background: rgba(255,255,255,.035);
            border: 1px solid rgba(255,255,255,.09);
            color: #f2f5f3;
            border-radius: 13px;
            padding: 12px 15px;
            transition: .25s ease;
        }

            .job-field .form-control:focus {
                background: rgba(255,255,255,.045);
                border-color: #39ff88;
                color: #fff;
                box-shadow: 0 0 0 3px rgba(57,255,136,.08), 0 0 20px rgba(57,255,136,.06);
            }

        .job-field textarea.form-control {
            min-height: 280px;
            line-height: 1.7;
            resize: vertical;
        }

    .text-danger {
        color: #ff7777 !important;
        font-size: .82rem;
    }

    .job-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .neon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid #39ff88;
        background: #39ff88;
        color: #07100b;
        font-weight: 700;
        border-radius: 11px;
        padding: 11px 20px;
        text-decoration: none;
        transition: .25s ease;
    }

        .neon-btn:hover {
            color: #07100b;
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(57,255,136,.25);
        }

    .outline-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid rgba(255,255,255,.14);
        background: rgba(255,255,255,.025);
        color: #b7c0ba;
        font-weight: 600;
        border-radius: 11px;
        padding: 11px 20px;
        text-decoration: none;
        transition: .25s ease;
    }

        .outline-btn:hover {
            color: #fff;
            border-color: rgba(57,255,136,.35);
            background: rgba(57,255,136,.05);
            transform: translateY(-2px);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 600px) {

        .job-page {
            padding: 30px 15px 50px;
        }

        .job-form-card {
            padding: 22px;
            border-radius: 19px;
        }

        .job-actions {
            flex-direction: column;
        }

            .job-actions a,
            .job-actions button {
                width: 100%;
            }
    }

</style>


<div class="job-page">

    <div class="job-form-wrapper">

        <div class="job-header">

            <div class="job-eyebrow">
                <span></span>
                JOB INTELLIGENCE
            </div>

            <h1>Edit Job Description</h1>

            <p>
                Update the job opportunity and keep the
                information used by AJACAS for CV matching accurate.
            </p>

        </div>


        <div class="job-form-card">

            <div class="form-section-title">
                <i class="bi bi-pencil-square"></i>
                Update Opportunity
            </div>


            <form asp-action="Edit"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <input type="hidden"
                       name="id"
                       value="@ViewContext.RouteData.Values["id"]" />


                <div class="job-field">

                    <label asp-for="JobTitle"
                           class="form-label">
                    </label>

                    <input asp-for="JobTitle"
                           class="form-control" />

                    <span asp-validation-for="JobTitle"
                          class="text-danger">
                    </span>

                </div>


                <div class="job-field">

                    <label asp-for="CompanyName"
                           class="form-label">
                    </label>

                    <input asp-for="CompanyName"
                           class="form-control" />

                    <span asp-validation-for="CompanyName"
                          class="text-danger">
                    </span>

                </div>


                <div class="job-field">

                    <label asp-for="Location"
                           class="form-label">
                    </label>

                    <input asp-for="Location"
                           class="form-control" />

                    <span asp-validation-for="Location"
                          class="text-danger">
                    </span>

                </div>


                <div class="job-field mb-0">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="12"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <div class="job-actions">

                    <button type="submit"
                            class="neon-btn">

                        <i class="bi bi-check-lg"></i>
                        Save Changes

                    </button>


                    <a asp-action="Index"
                       class="outline-btn">

                        <i class="bi bi-x-lg"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}