
@model IEnumerable<AJACAS.Models.Education>

@{
    ViewData["Title"] = "Education";
}


<div class="education-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ajacas-alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }


    <!-- PAGE HEADER -->
    <div class="education-header">

        <div>

            <div class="education-eyebrow">
                <span class="eyebrow-dot"></span>
                EDUCATIONAL BACKGROUND
            </div>

            <h1>Education</h1>

            <p>
                Manage the academic qualifications and educational
                experiences that form part of your professional profile.
            </p>

        </div>


        <a asp-action="Create"
           class="add-education-btn">

            <i class="bi bi-plus-lg"></i>

            <span>Add Education</span>

        </a>

    </div>


    @if (!Model.Any())
    {
        <!-- EMPTY STATE -->
        <div class="empty-education-card">

            <div class="empty-education-icon">
                <i class="bi bi-mortarboard"></i>
            </div>

            <div>

                <h3>No education records yet</h3>

                <p>
                    Add your educational background to help
                    complete your professional profile.
                </p>

                <a asp-action="Create"
                   class="empty-action">

                    <i class="bi bi-plus-lg"></i>

                    Add Education

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- EDUCATION GRID -->
        <div class="education-grid">

            @foreach (var education in Model)
            {
                <div class="education-card">

                    <!-- CARD TOP -->
                    <div class="education-card-top">

                        <div class="education-icon">

                            <i class="bi bi-mortarboard-fill"></i>

                        </div>


                        <div class="education-actions">

                            <a asp-action="Edit"
                               asp-route-id="@education.EducationId"
                               class="icon-action"
                               title="Edit education">

                                <i class="bi bi-pencil"></i>

                            </a>


                            <form asp-action="Delete"
                                  asp-route-id="@education.EducationId"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this education record?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="icon-action delete-action"
                                        title="Delete education">

                                    <i class="bi bi-trash3"></i>

                                </button>

                            </form>

                        </div>

                    </div>


                    <!-- INSTITUTION -->
                    <div class="education-content">

                        <div class="institution-row">

                            <h3>
                                @education.Institution
                            </h3>


                            @if (education.IsCurrent)
                            {
                                <span class="current-badge">

                                    <span></span>

                                    Current

                                </span>
                            }

                        </div>


                        @if (!string.IsNullOrEmpty(education.Degree))
                        {
                            <p class="degree">

                                <i class="bi bi-award"></i>

                                @education.Degree

                            </p>
                        }


                        @if (!string.IsNullOrEmpty(education.FieldOfStudy))
                        {
                            <p class="field-of-study">

                                <i class="bi bi-book"></i>

                                @education.FieldOfStudy

                            </p>
                        }

                    </div>


                    <!-- DATES -->
                    <div class="education-date">

                        <i class="bi bi-calendar3"></i>

                        <span>

                            @if (education.StartDate.HasValue)
                            {
                                @education.StartDate.Value.ToString("MMM yyyy")
                            }

                            <span class="date-separator">—</span>

                            @if (education.IsCurrent)
                            {
                                <span>Present</span>
                            }
                            else if (education.EndDate.HasValue)
                            {
                                @education.EndDate.Value.ToString("MMM yyyy")
                            }

                        </span>

                    </div>


                    <!-- DESCRIPTION -->
                    @if (!string.IsNullOrEmpty(education.Description))
                    {
                        <div class="education-description">

                            <span class="description-label">
                                ABOUT
                            </span>

                            <p>
                                @education.Description
                            </p>

                        </div>
                    }


                    <!-- FOOTER -->
                    <div class="education-footer">

                        <span>

                            <i class="bi bi-check2-circle"></i>

                            Education record

                        </span>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>

    /* =========================================
           EDUCATION PAGE
           ========================================= */

    .education-page {
        min-height: 100vh;
        padding: 55px 6% 80px;
        color: #eef3ef;
        animation: educationPageIn .7s ease both;
    }


    /* =========================================
           SUCCESS ALERT
           ========================================= */

    .ajacas-alert {
        max-width: 1100px;
        margin: 0 auto 30px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border-radius: 14px;
        border: 1px solid rgba(57,255,136,.2);
        background: rgba(57,255,136,.06);
        color: #bfffd5;
        animation: slideDown .5s ease both;
    }


        .ajacas-alert i {
            color: #39ff88;
            font-size: 18px;
        }


    /* =========================================
           HEADER
           ========================================= */

    .education-header {
        max-width: 1100px;
        margin: 0 auto 42px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
    }


    .education-eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
        color: #39ff88;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }


    .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #39ff88;
        box-shadow: 0 0 12px rgba(57,255,136,.8);
    }


    .education-header h1 {
        margin: 0;
        color: #f4f8f5;
        font-size: clamp(32px, 4vw, 48px);
        font-weight: 700;
        letter-spacing: -1.5px;
    }


    .education-header p {
        max-width: 650px;
        margin: 12px 0 0;
        color: #7c8792;
        font-size: 15px;
        line-height: 1.7;
    }


    /* =========================================
           ADD BUTTON
           ========================================= */

    .add-education-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 19px;
        border-radius: 12px;
        background: #39ff88;
        color: #07100b;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 0 22px rgba(57,255,136,.14);
        transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
    }


        .add-education-btn:hover {
            color: #07100b;
            background: #57ff9b;
            transform: translateY(-3px);
            box-shadow: 0 8px 28px rgba(57,255,136,.25);
        }


    /* =========================================
           EDUCATION GRID
           ========================================= */

    .education-grid {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }


    /* =========================================
           EDUCATION CARD
           ========================================= */

    .education-card {
        position: relative;
        padding: 24px;
        border-radius: 21px;
        border: 1px solid rgba(255,255,255,.07);
        background: linear-gradient( 145deg, rgba(255,255,255,.045), rgba(255,255,255,.018) );
        box-shadow: 0 15px 45px rgba(0,0,0,.12);
        overflow: hidden;
        transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
        animation: cardAppear .6s ease both;
    }


        .education-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -100px;
            right: -80px;
            border-radius: 50%;
            background: rgba(57,255,136,.045);
            filter: blur(35px);
            pointer-events: none;
        }


        .education-card:hover {
            transform: translateY(-6px);
            border-color: rgba(57,255,136,.22);
            box-shadow: 0 18px 50px rgba(0,0,0,.18), 0 0 30px rgba(57,255,136,.04);
        }


    /* =========================================
           CARD TOP
           ========================================= */

    .education-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 23px;
    }


    .education-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: rgba(57,255,136,.09);
        border: 1px solid rgba(57,255,136,.15);
        color: #39ff88;
        font-size: 20px;
        box-shadow: 0 0 20px rgba(57,255,136,.05);
    }


    /* =========================================
           ACTIONS
           ========================================= */

    .education-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }


        .education-actions form {
            margin: 0;
        }


    .icon-action {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        border: 1px solid rgba(255,255,255,.07);
        background: rgba(255,255,255,.025);
        color: #89939d;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }


        .icon-action:hover {
            color: #39ff88;
            border-color: rgba(57,255,136,.2);
            background: rgba(57,255,136,.07);
            transform: translateY(-2px);
        }


    .delete-action:hover {
        color: #ff6b7a;
        border-color: rgba(255,107,122,.2);
        background: rgba(255,107,122,.06);
    }


    /* =========================================
           CONTENT
           ========================================= */

    .institution-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
    }


    .education-content h3 {
        margin: 0 0 11px;
        color: #f0f5f1;
        font-size: 20px;
        font-weight: 650;
        line-height: 1.3;
    }


    .degree,
    .field-of-study {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 8px;
        font-size: 13px;
    }


    .degree {
        color: #dce5df;
        font-weight: 600;
    }


    .field-of-study {
        color: #7d8881;
    }


        .degree i,
        .field-of-study i {
            width: 16px;
            color: #39ff88;
        }


    /* =========================================
           CURRENT BADGE
           ========================================= */

    .current-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 7px;
        background: rgba(57,255,136,.07);
        border: 1px solid rgba(57,255,136,.13);
        color: #72ffad;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }


        .current-badge span {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #39ff88;
            box-shadow: 0 0 8px rgba(57,255,136,.8);
        }


    /* =========================================
           DATE
           ========================================= */

    .education-date {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 20px;
        padding: 11px 13px;
        border-radius: 10px;
        background: rgba(255,255,255,.025);
        border: 1px solid rgba(255,255,255,.045);
        color: #7f8983;
        font-size: 12px;
    }


        .education-date i {
            color: #39ff88;
        }


    .date-separator {
        margin: 0 5px;
        color: #4d5751;
    }


    /* =========================================
           DESCRIPTION
           ========================================= */

    .education-description {
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid rgba(255,255,255,.06);
    }


    .description-label {
        display: block;
        margin-bottom: 8px;
        color: #59645e;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }


    .education-description p {
        margin: 0;
        color: #7c8792;
        font-size: 12px;
        line-height: 1.7;
    }


    /* =========================================
           FOOTER
           ========================================= */

    .education-footer {
        margin-top: 20px;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,.06);
        color: #68737d;
        font-size: 11px;
    }


        .education-footer i {
            margin-right: 5px;
            color: #39ff88;
        }


    /* =========================================
           EMPTY STATE
           ========================================= */

    .empty-education-card {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 25px;
        padding: 35px;
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,.07);
        background: linear-gradient( 145deg, rgba(255,255,255,.045), rgba(255,255,255,.018) );
        box-shadow: 0 15px 45px rgba(0,0,0,.12);
        animation: cardAppear .7s ease both;
    }


    .empty-education-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 18px;
        background: rgba(57,255,136,.08);
        border: 1px solid rgba(57,255,136,.14);
        color: #39ff88;
        font-size: 27px;
        box-shadow: 0 0 25px rgba(57,255,136,.06);
    }


    .empty-education-card h3 {
        margin: 0 0 7px;
        color: #edf3ee;
        font-size: 20px;
    }


    .empty-education-card p {
        margin: 0 0 17px;
        color: #7c8792;
        font-size: 14px;
    }


    .empty-action {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #39ff88;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: gap .2s ease;
    }


        .empty-action:hover {
            color: #62ffa1;
            gap: 11px;
        }


    /* =========================================
           ANIMATIONS
           ========================================= */

    @@keyframes educationPageIn {

        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes slideDown {

        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @@keyframes cardAppear {

        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================
           RESPONSIVE
           ========================================= */

    @@media (max-width: 850px) {

        .education-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 700px) {

        .education-page {
            padding: 40px 20px 60px;
        }

        .education-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .add-education-btn {
            width: 100%;
        }

        .empty-education-card {
            align-items: flex-start;
            flex-direction: column;
        }
    }


    @@media (max-width: 500px) {

        .education-header h1 {
            font-size: 34px;
        }

        .education-card {
            padding: 19px;
        }

        .institution-row {
            flex-direction: column;
            gap: 8px;
        }

        .current-badge {
            align-self: flex-start;
        }
    }

</style>